<UserControl x:Class="QDTool.CompressionOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Compression" Padding="10" Margin="0,12,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Algorithm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="algorithmComboBox"
                          Grid.Column="1"
                          MinWidth="150"
                          SelectedIndex="0"
                          SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="None" Tag="None"/>
                    <ComboBoxItem Content="Auto (smallest safe)" Tag="Auto"/>
                    <ComboBoxItem Content="ZX0" Tag="Zx0"/>
                    <ComboBoxItem Content="ZX7" Tag="Zx7"/>
                </ComboBox>
            </Grid>

            <StackPanel x:Name="directionPanel" Margin="0,9,0,0">
                <TextBlock Text="Direction:" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="forwardRadioButton"
                                 Content="Forward"
                                 IsChecked="True"
                                 Checked="Option_Changed"/>
                    <RadioButton x:Name="backwardRadioButton"
                                 Content="Backward"
                                 Margin="16,0,0,0"
                                 Checked="Option_Changed"/>
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="quickCheckBox"
                      Content="ZX0 quick (non-optimal)"
                      Margin="0,9,0,0"
                      Checked="Option_Changed"
                      Unchecked="Option_Changed"/>
            <CheckBox x:Name="embeddedCheckBox"
                      Content="ZX7 embedded loader in MZF header"
                      Margin="0,9,0,0"
                      Checked="Option_Changed"
                      Unchecked="Option_Changed"/>

            <Expander x:Name="expertExpander" Header="Expert / partial" Margin="0,9,0,0">
                <StackPanel Margin="16,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Skip bytes:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="skipTextBox"
                                 Width="80"
                                 Text="0"
                                 TextChanged="Option_Changed"/>
                    </StackPanel>
                    <TextBlock Foreground="DimGray"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Text="Forward uses an existing prefix; backward uses an existing suffix. This is an expert partial-compression workflow."/>
                </StackPanel>
            </Expander>

            <TextBlock x:Name="targetHintTextBlock"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </GroupBox>
</UserControl>
