<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Controls.DiskPhysicalPanel" x:DataType="vm:ShellViewModel">
<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8" Margin="0,12,0,0"><WrapPanel><ComboBox ItemsSource="{Binding ActiveDisk.TrackIndices}" SelectedItem="{Binding ActiveDisk.TrackIndex, Mode=TwoWay}" MinWidth="80" AutomationProperties.Name="Physical track index" /><Button Content="Load track" Command="{Binding DiskLoadTrackCommand}" Margin="6,0" /><Button Content="Zoom +" Click="CellsZoomIn" Margin="0,0,6,0" /><Button Content="Zoom −" Click="CellsZoomOut" Margin="0,0,6,0" /><Button Content="Fit all" Click="CellsFit" /></WrapPanel><c:DiskTrackView Grid.Row="1" x:Name="Cells" /><TextBlock Grid.Row="2" Text="Physical cells and weak mask; index markers. DSK timing is generated, HFE timing is declared/stored. No measured flux." TextWrapping="Wrap" Classes="muted" /><c:ReportViewer Grid.Row="3" Text="{Binding ActiveDisk.PhysicalReport}" /></Grid>
</UserControl>
