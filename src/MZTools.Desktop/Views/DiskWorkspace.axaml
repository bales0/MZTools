<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Views.DiskWorkspace" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,*" RowSpacing="0">
  <Border Padding="8" BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8"><WrapPanel IsEnabled="{Binding CanUseDisk}">
   <Button Content="Disk ▾" Classes="wpfToolbar" Click="OpenWpfMenu"><Button.ContextMenu><ContextMenu>
    <MenuItem Header="Convert Format..."><MenuItem Header="Container format..." Tag="Export converted container" Click="WpfDiskTool" /><MenuItem Header="Filesystem..." Tag="Convert filesystem" Click="WpfDiskTool" /></MenuItem><MenuItem Header="Format disk…" Tag="Format disk" Click="WpfDiskTool" /><MenuItem Header="Normalize Container..." Tag="Normalize container" Click="WpfDiskTool" /><MenuItem Header="Compare with..." Tag="Compare image" Click="WpfDiskTool" /><MenuItem Header="Batch Process..." Command="{Binding BatchPreviewCommand}" /><MenuItem Header="Repair Container…" Tag="Container repair" Click="WpfDiskTool" />
   </ContextMenu></Button.ContextMenu></Button>
   <Button Content="Filesystem ▾" Classes="wpfToolbar" Click="OpenWpfMenu"><Button.ContextMenu><ContextMenu>
    <MenuItem Header="Copy from another disk..." Click="WpfCopyFromDisk" /><MenuItem Header="File Properties..." Click="WpfDiskProperties" /><MenuItem Header="Structure Inspector..." Click="WpfDiskStructure" /><MenuItem Header="Attach / Edit CP/M Layout..." Tag="CP/M layout" Click="WpfDiskTool" /><MenuItem Header="Defragment..." Tag="Defragment" Click="WpfDiskTool" /><MenuItem Header="Guided Repair..." Tag="Filesystem repair" Click="WpfDiskTool" /><Separator /><MenuItem Header="Copy to Tape..." Tag="Copy to Tape" Click="WpfDiskTool" /><MenuItem Header="Open CP/M block..." Tag="Open CP/M block" Click="WpfDiskTool" />
   </ContextMenu></Button.ContextMenu></Button>
   <Button Content="Boot / System ▾" Classes="wpfToolbar" Click="OpenWpfMenu"><Button.ContextMenu><ContextMenu>
    <MenuItem Header="Bootstrap / IPLPRO..."><MenuItem Header="Export bootstrap..." Tag="Bootstrap export" Click="WpfDiskTool" /><MenuItem Header="Import bootstrap..." Tag="Bootstrap import" Click="WpfDiskTool" /><MenuItem Header="Export header..." Tag="Bootstrap header export" Click="WpfDiskTool" /><MenuItem Header="Import header..." Tag="Bootstrap header import" Click="WpfDiskTool" /><MenuItem Header="Metadata..." Tag="Bootstrap metadata" Click="WpfDiskTool" /><MenuItem Header="Clear bootstrap..." Tag="Bootstrap clear" Click="WpfDiskTool" /></MenuItem>
    <MenuItem Header="Make Bootable / Install CP/M System..." Tag="Install boot/system" Click="WpfDiskTool" /><MenuItem Header="Boot / System profiles..." Tag="Manage profiles" Click="WpfDiskTool" />
   </ContextMenu></Button.ContextMenu></Button>
   <Button Content="Tools ▾" Classes="wpfToolbar" Click="OpenWpfMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="Visual analysis…" Click="WpfDiskAnalysis" /><MenuItem Header="MZF/M12 → COM..." Tag="Import Native COM" Click="WpfDiskTool" />
    <MenuItem Header="Sector / physical tools"><MenuItem Header="Physical Properties..." Tag="Physical properties" Click="WpfDiskTool" /><MenuItem Header="Export sectors..." Tag="Raw export" Click="WpfDiskTool" /><MenuItem Header="Import sectors..." Tag="Raw import" Click="WpfDiskTool" /><MenuItem Header="Export patch..." Tag="Export patch" Click="WpfDiskTool" /><MenuItem Header="Apply patch..." Tag="Apply patch" Click="WpfDiskTool" /></MenuItem>
    <MenuItem Header="IPL programs"><MenuItem Header="Add programs..." Tag="IPL add programs" Click="WpfDiskTool" /><MenuItem Header="Rename / Compression..." Tag="IPL rename / compression" Click="WpfDiskTool" /><MenuItem Header="Move up" Tag="IPL move up" Click="WpfDiskTool" /><MenuItem Header="Move down" Tag="IPL move down" Click="WpfDiskTool" /><MenuItem Header="Delete programs..." Tag="IPL delete programs" Click="WpfDiskTool" /></MenuItem></ContextMenu></Button.ContextMenu></Button>
   <Button Content="Open..." Classes="wpfToolbar" Command="{Binding OpenCommand}" /><Button Content="Add..." IsVisible="{Binding ActiveDisk.ShowFileCommands}" Classes="wpfToolbar" Command="{Binding DiskImportCommand}" /><Button Content="Export..." IsVisible="{Binding ActiveDisk.ShowFileCommands}" Classes="wpfToolbar" Command="{Binding DiskExportCommand}" /><Button Content="Delete" IsVisible="{Binding ActiveDisk.ShowFileCommands}" Classes="wpfToolbar" Command="{Binding DiskDeleteCommand}" /><Button Content="Save" Classes="wpfToolbar" Command="{Binding SaveCommand}" /><Button Content="Save As..." Classes="wpfToolbar" Command="{Binding SaveAsCommand}" /><Button Content="Close" Classes="wpfToolbar" Command="{Binding CloseCommand}" />
  </WrapPanel></Border>
  <Grid Grid.Row="1" x:Name="DiskGrid" ColumnDefinitions="*,16,288">
   <TabControl x:Name="DiskTabs" SelectedIndex="{Binding ActiveDisk.ViewIndex, Mode=TwoWay}" IsEnabled="{Binding CanUseDisk}">
    <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></TabControl.ItemsPanel>
    <TabItem Header="Files"><Grid RowDefinitions="Auto,*" RowSpacing="0" Margin="0">
     <TextBox IsVisible="False" x:Name="DiskFilter" Text="{Binding ActiveDisk.Filter, Mode=TwoWay}" PlaceholderText="Filter disk files…" AutomationProperties.Name="Filter disk files" />
     <TableView Grid.Row="1" x:Name="DiskFiles" AutoScrollToSelectedItem="False" ItemsSource="{Binding ActiveDisk.Files}" SelectionMode="Multiple" AutomationProperties.Name="Disk files" DragDrop.AllowDrop="True">
      <TableView.Columns>
       <TableViewColumn Header="Name" Binding="{ReflectionBinding Name}" Width="2*" /><TableViewColumn Header="Bytes" Binding="{ReflectionBinding Bytes}" Width="85" />
       <TableViewColumn Header="Type" Binding="{ReflectionBinding Type}" Width="65" /><TableViewColumn Header="Load" Binding="{ReflectionBinding Load}" Width="80" /><TableViewColumn Header="Execute" Binding="{ReflectionBinding Execute}" Width="80" /><TableViewColumn Header="Attributes" Binding="{ReflectionBinding Attributes}" Width="2*" />
      </TableView.Columns>
      <TableView.ContextMenu><ContextMenu><MenuItem Header="Export…" Command="{Binding DiskExportCommand}" /><MenuItem Header="Copy files" Command="{Binding DiskCopyCommand}" /><MenuItem Header="Paste files…" Command="{Binding DiskPasteCommand}" /><Separator /><MenuItem Header="Delete…" Command="{Binding DiskDeleteCommand}" /></ContextMenu></TableView.ContextMenu>
     </TableView>
    </Grid></TabItem>
    <TabItem Header="Disk Map"><Grid RowDefinitions="*,Auto">
     <Grid Margin="8" ColumnDefinitions="3*,6,2*" RowDefinitions="56,Auto,*" x:Name="WpfMapBody">
      <TextBlock x:Name="DiskAnalysisSummary" Grid.ColumnSpan="3" TextWrapping="Wrap" />
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
       <TextBlock Text="Order:" VerticalAlignment="Center" /><ComboBox x:Name="DiskMapOrder" Width="115" Margin="6,0,12,0" SelectionChanged="WpfMapOrderChanged"><ComboBoxItem Content="Physical" /><ComboBoxItem Content="Logical" /></ComboBox>
       <Button x:Name="DiskClearSelection" Content="Clear selection" Click="WpfClearMap" IsEnabled="False" /><Button Content="Copy report" Command="{Binding CopyReportCommand}" Margin="6,0" /><Button Content="Save report..." Click="WpfSaveAnalysis" />
       <ComboBox IsVisible="False" x:Name="MapMode" SelectedIndex="{Binding ActiveDisk.MapMode, Mode=TwoWay}" SelectionChanged="MapModeChanged"><ComboBoxItem Content="Track map" /><ComboBoxItem Content="Surface side 0" /><ComboBoxItem Content="Surface side 1" /></ComboBox>
      </WrapPanel>
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><c:DiskMap x:Name="Map" Session="{Binding ActiveDisk}" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Top" /></ScrollViewer>
      <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" RowDefinitions="42,3*,6,2*">
       <UniformGrid Columns="5" Margin="0,0,0,4"><Button x:Name="MapAllCount" Tag="0" Click="WpfCountFilter" FontSize="11" /><Button x:Name="MapErrorsCount" Tag="1" Click="WpfCountFilter" FontSize="11" /><Button x:Name="MapUnsafeCount" Tag="4" Click="WpfCountFilter" FontSize="11" /><Button x:Name="MapWarningsCount" Tag="2" Click="WpfCountFilter" FontSize="11" /><Button x:Name="MapInfoCount" Tag="3" Click="WpfCountFilter" FontSize="11" /></UniformGrid>
       <TabControl Grid.Row="1" x:Name="MapInspectorTabs">
        <TabItem Header="Blocks"><TableView x:Name="DiskSectors" ItemsSource="{Binding ActiveDisk.Sectors}" SelectionMode="Multiple" AutomationProperties.Name="Disk sectors" AutoScrollToSelectedItem="False">
         <TableView.Columns><TableViewColumn Header="Track" Binding="{ReflectionBinding Track}" Width="55" /><TableViewColumn Header="R" Binding="{ReflectionBinding R}" Width="40" /><TableViewColumn Header="Role" Binding="{ReflectionBinding Role}" Width="100" /><TableViewColumn Header="File / details" Binding="{ReflectionBinding Files}" Width="*" /><TableViewColumn Header="Bytes" Binding="{ReflectionBinding Bytes}" Width="65" /><TableViewColumn Header="Offset" Binding="{ReflectionBinding Offset}" Width="90" /></TableView.Columns>
        </TableView></TabItem>
        <TabItem Header="Issues"><DockPanel>
         <WrapPanel DockPanel.Dock="Top" Margin="4"><TextBlock Text="Severity:" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox x:Name="MapIssueFilter" Width="100" SelectionChanged="WpfIssueFilterChanged"><ComboBoxItem Content="All" /><ComboBoxItem Content="Errors" /><ComboBoxItem Content="Warnings" /><ComboBoxItem Content="Info" /><ComboBoxItem Content="Unsafe" /></ComboBox></WrapPanel>
         <ScrollViewer DockPanel.Dock="Top" Height="64" Margin="4,0,4,4"><TextBlock x:Name="MapSeverityMeaning" TextWrapping="Wrap" FontSize="11" /></ScrollViewer>
         <TableView x:Name="Findings" ItemsSource="{Binding ActiveDisk.Findings}" SelectedItem="{Binding ActiveDisk.SelectedFinding, Mode=TwoWay}"><TableView.Columns><TableViewColumn Header="Severity" Binding="{ReflectionBinding Severity}" Width="75" /><TableViewColumn Header="Code" Binding="{ReflectionBinding Code}" Width="130" /><TableViewColumn Header="Location" Binding="{ReflectionBinding Location}" Width="110" /><TableViewColumn Header="Description" Binding="{ReflectionBinding Description}" Width="*" /></TableView.Columns></TableView>
        </DockPanel></TabItem>
       </TabControl>
       <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="LightGray" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
       <Expander Grid.Row="3" Header="Selection / sector details" IsExpanded="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><c:DskReportView x:Name="MapSectorDetails" CompactHeader="False" Margin="0,4,0,0" /></Expander>
      </Grid>
     </Grid>
     <DockPanel Grid.Row="1" Margin="8,0,8,8"><Button DockPanel.Dock="Right" Content="Apply DSK patch..." Tag="Apply patch" Click="WpfMapTool" Margin="8,0,0,0" /><Button DockPanel.Dock="Right" x:Name="MapHexButton" Content="Hex editor..." Click="WpfOpenMapHex" Margin="8,0,0,0" /><StackPanel Orientation="Horizontal"><TextBlock Text="Hex buffer:" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="MapHexBuffer" MinWidth="180" Margin="0,0,8,0" /><TextBlock x:Name="MapHexReason" TextWrapping="Wrap" VerticalAlignment="Center" /></StackPanel></DockPanel>
    </Grid></TabItem>
    <TabItem Header="Analysis"><TextBlock Text="Use the Issues tab in Disk Map or Visual analysis." /></TabItem>
    <TabItem Header="Hex"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="0,12,0,0"><TextBlock Text="{Binding ActiveDisk.HexTitle}" TextWrapping="Wrap" Classes="muted" /><ScrollViewer Grid.Row="1" x:Name="DiskHexScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBlock Text="Offset / DSK offset" /><TextBlock Grid.Column="1" Text="HEX" /><TextBlock Grid.Column="2" Text="ASCII" /><TextBlock Grid.Column="3" Text="MZASCII (SHASCII EU)" />
      <TextBox Grid.Row="1" x:Name="DiskHexOffsets" Text="{Binding ActiveDisk.HexOffsets}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono" FontSize="12" LineHeight="18" Padding="2" Margin="0,5,0,0" BorderThickness="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Hex row buffer and source addresses" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="DiskHex" Text="{Binding ActiveDisk.HexText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" IsReadOnly="True" FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono" FontSize="12" LineHeight="18" Padding="2" Margin="0,5,0,0" BorderThickness="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Fixed-size disk hex buffer" />
      <TextBox Grid.Row="1" Grid.Column="2" x:Name="DiskHexAscii" Text="{Binding ActiveDisk.HexAscii}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono" FontSize="12" LineHeight="18" Padding="2" Margin="0,5,0,0" BorderThickness="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="ASCII preview" />
      <TextBox Grid.Row="1" Grid.Column="3" x:Name="DiskHexSharpAscii" Text="{Binding ActiveDisk.HexSharpAscii}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono" FontSize="12" LineHeight="18" Padding="2" Margin="0,5,0,0" BorderThickness="1" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="SHASCII preview" />
     </Grid></ScrollViewer><StackPanel Grid.Row="2"><TextBlock x:Name="DiskHexPosition" Text="Select a byte in HEX / ASCII / MZASCII." /><WrapPanel><Button Content="Unlock HEX editing…" Click="UnlockHex" IsEnabled="{Binding ActiveDisk.CanEditHex}" Margin="0,0,6,0" /><TextBlock Text="Fixed-size overwrite · Delete cannot remove bytes" Margin="4" /><Button Content="Apply hex…" Command="{Binding DiskApplyHexCommand}" Margin="0,0,6,0" /><Button Content="Cancel edits" Command="{Binding DiskCancelDraftCommand}" /></WrapPanel></StackPanel></Grid></TabItem>
    <TabItem Header="Physical"><Grid RowDefinitions="*,Auto"><c:DiskPhysicalPanel x:Name="PhysicalPanel" /><Button Grid.Row="1" Content="Open physical detail" Click="PhysicalDetail" /></Grid></TabItem>
    <TabItem Header="Compare"><Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,12,0,0"><TextBlock Text="{Binding ActiveDisk.ComparisonReport}" TextWrapping="Wrap" /><TableView Grid.Row="1" x:Name="Differences" ItemsSource="{Binding ActiveDisk.Differences}" SelectionChanged="DifferenceSelected"><TableView.Columns><TableViewColumn Header="Level" Binding="{ReflectionBinding Level}" Width="100" /><TableViewColumn Header="State" Binding="{ReflectionBinding State}" Width="90" /><TableViewColumn Header="Item" Binding="{ReflectionBinding Name}" Width="*" /></TableView.Columns></TableView></Grid></TabItem>
    <TabItem Header="Structure"><c:ReportViewer Text="{Binding ActiveDisk.Structure}" Margin="0,12,0,0" /></TabItem>
    <TabItem Header="Report"><c:ReportViewer Text="{Binding ActiveDisk.Report}" Margin="0,12,0,0" /></TabItem>
   </TabControl>
   <Border Grid.Column="2" x:Name="DiskInspectorPanel" Classes="panel" Margin="0,44,0,0"><c:DiskInspector x:Name="Inspector" /></Border>
  </Grid>
 </Grid>
</UserControl>
