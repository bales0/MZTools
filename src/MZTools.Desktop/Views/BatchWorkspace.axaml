<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Views.BatchWorkspace" x:DataType="vm:ShellViewModel">
 <Grid RowDefinitions="Auto,Auto,Auto,300,*" RowSpacing="10">
  <WrapPanel><Button Content="New batch / Preview…" Command="{Binding BatchPreviewCommand}" Margin="0,0,8,0" /><Button Content="Execute prepared batch…" Command="{Binding BatchExecuteCommand}" Margin="0,0,8,0" /><Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,8,0" /><Button Content="Export report…" Command="{Binding BatchReportCommand}" /></WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding ActiveBatch.Summary}" TextWrapping="Wrap" />
  <StackPanel Grid.Row="2" IsVisible="{Binding Documents.IsBusy}"><TextBlock Text="{Binding Documents.Status}" TextWrapping="Wrap" /><ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Documents.ProgressFraction}" IsIndeterminate="{Binding !Documents.HasProgress}" /></StackPanel>
  <TableView Grid.Row="3" x:Name="BatchRows" ItemsSource="{Binding ActiveBatch.Rows}" SelectedItem="{Binding ActiveBatch.Selected, Mode=TwoWay}" AutomationProperties.Name="Batch preflight and execution results"><TableView.Columns><TableViewColumn Header="Input" Binding="{ReflectionBinding Input}" Width="2*" /><TableViewColumn Header="Output" Binding="{ReflectionBinding Output}" Width="2*" /><TableViewColumn Header="Operation" Binding="{ReflectionBinding Operation}" Width="130" /><TableViewColumn Header="Format" Binding="{ReflectionBinding Format}" Width="100" /><TableViewColumn Header="Result" Binding="{ReflectionBinding Result}" Width="120" /><TableViewColumn Header="Severity" Binding="{ReflectionBinding Severity}" Width="90" /><TableViewColumn Header="Integrity" Binding="{ReflectionBinding Integrity}" Width="100" /><TableViewColumn Header="Reason" Binding="{ReflectionBinding Reason}" Width="3*" /></TableView.Columns></TableView>
  <TabControl Grid.Row="4"><TabItem Header="Selected details"><c:ReportViewer Text="{Binding ActiveBatch.Detail}" /></TabItem><TabItem Header="Contents"><TableView ItemsSource="{Binding ActiveBatch.Contents}" AutomationProperties.Name="Selected batch file contents"><TableView.Columns><TableViewColumn Header="#" Binding="{ReflectionBinding Number}" Width="50" /><TableViewColumn Header="Name" Binding="{ReflectionBinding Name}" Width="*" /><TableViewColumn Header="Bytes" Binding="{ReflectionBinding Size}" Width="100" /><TableViewColumn Header="Type" Binding="{ReflectionBinding Type}" Width="70" /><TableViewColumn Header="LOAD" Binding="{ReflectionBinding Load}" Width="90" /><TableViewColumn Header="EXEC" Binding="{ReflectionBinding Execute}" Width="90" /><TableViewColumn Header="Profile" Binding="{ReflectionBinding Profile}" Width="160" /><TableViewColumn Header="Compression" Binding="{ReflectionBinding Compression}" Width="130" /><TableViewColumn Header="Attributes" Binding="{ReflectionBinding Attributes}" Width="160" /></TableView.Columns></TableView></TabItem><TabItem Header="Full report"><c:ReportViewer Text="{Binding ActiveBatch.Report}" /></TabItem></TabControl>
 </Grid>
</UserControl>
