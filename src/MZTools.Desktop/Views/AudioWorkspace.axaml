<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Views.AudioWorkspace" x:DataType="vm:ShellViewModel">
 <Grid x:Name="AudioGrid" ColumnDefinitions="*,16,288" MinHeight="720">
  <Grid RowDefinitions="Auto,220,Auto,*" RowSpacing="10">
   <WrapPanel>
    <Button Content="Select frames…" Command="{Binding AudioSelectFramesCommand}" Margin="0,0,6,6" /><Button Content="Measure selection" Command="{Binding AudioMeasureCommand}" Margin="0,0,6,6" /><Button Content="Deeper analysis…" Command="{Binding AudioRecoverCommand}" Margin="0,0,6,6" />
    <Button Content="Export WAV…" Command="{Binding AudioWaveExportCommand}" Margin="0,0,6,6" /><Button Content="Export programs…" Command="{Binding AudioProgramsExportCommand}" Margin="0,0,6,6" /><Button Content="Export report…" Command="{Binding AudioReportExportCommand}" Margin="0,0,6,6" />
   </WrapPanel>
   <c:AudioChart Grid.Row="1" x:Name="Waveform" Kind="Waveform" Session="{Binding ActiveAudio}" AutomationProperties.Name="Audio waveform in original frame coordinates" />
   <StackPanel Grid.Row="2" Spacing="6">
    <WrapPanel>
     <Button Content="Zoom +" Click="WaveZoomIn" Margin="0,0,6,6" /><Button Content="Zoom −" Click="WaveZoomOut" Margin="0,0,6,6" /><Button Content="Fit all" Click="WaveFit" Margin="0,0,6,6" /><Button Content="Fit selection" Click="WaveFitSelection" Margin="0,0,6,6" />
     <ComboBox ItemsSource="{Binding ActiveAudio.Channels}" SelectedIndex="{Binding ActiveAudio.ChannelMode, Mode=TwoWay}" MinWidth="110" Margin="0,0,6,6" AutomationProperties.Name="Displayed audio channels" />
     <CheckBox Content="Auto scale" IsChecked="{Binding ActiveAudio.AutoScale, Mode=TwoWay}" Margin="0,0,6,6" /><NumericUpDown Value="{Binding ActiveAudio.Gain, Mode=TwoWay}" Minimum="0.001" Maximum="1000" Increment="0.25" Width="110" Margin="0,0,6,6" AutomationProperties.Name="Display gain only" />
     <Button Content="Trigger…" Command="{Binding AudioTriggerCommand}" Margin="0,0,6,6" /><Button Content="Cancel detail" Command="{Binding AudioCancelDetailCommand}" IsVisible="{Binding ActiveAudio.IsPreviewBusy}" />
    </WrapPanel>
    <TextBlock Text="{Binding ActiveAudio.SelectionSummary}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="Shift+drag selects; wheel zooms at pointer, drag pans. Frame intervals are [start,end). Gain never changes source PCM." Classes="muted" TextWrapping="Wrap" />
   </StackPanel>
   <TabControl Grid.Row="3" x:Name="AudioTabs" SelectedIndex="{Binding ActiveAudio.ViewIndex, Mode=TwoWay}">
    <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></TabControl.ItemsPanel>
    <TabItem Header="Records"><Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
     <TableView x:Name="AudioBlocks" ItemsSource="{Binding ActiveAudio.Blocks}" SelectionMode="Multiple" AutoScrollToSelectedItem="False" IsEnabled="{Binding CanUseAudio}" AutomationProperties.Name="Audio records and decoded blocks">
      <TableView.Columns><TableViewColumn Header="#" Binding="{ReflectionBinding Record}" Width="40" /><TableViewColumn Header="Name" Binding="{ReflectionBinding Name}" Width="*" /><TableViewColumn Header="Block" Binding="{ReflectionBinding Block}" Width="90" /><TableViewColumn Header="Profile" Binding="{ReflectionBinding Profile}" Width="120" /><TableViewColumn Header="Ch" Binding="{ReflectionBinding Channel}" Width="40" /><TableViewColumn Header="Checksum" Binding="{ReflectionBinding Checksum}" Width="85" /><TableViewColumn Header="Start frame" Binding="{ReflectionBinding Start}" Width="110" /><TableViewColumn Header="End frame" Binding="{ReflectionBinding End}" Width="110" /><TableViewColumn Header="Detector" Binding="{ReflectionBinding Detector}" Width="130" /></TableView.Columns>
     </TableView><WrapPanel Grid.Row="1"><Button Content="Selected record" Click="SelectedRecord" Margin="0,0,6,0" /><Button Content="Open graph detail" Click="OpenGraph" /></WrapPanel>
    </Grid></TabItem>
    <TabItem Header="Pulses"><Grid RowDefinitions="Auto,Auto,120,Auto,280" RowSpacing="8" Margin="0,8,0,0">
     <WrapPanel><ComboBox ItemsSource="{Binding ActiveAudio.MeasurementModes}" SelectedIndex="{Binding ActiveAudio.MeasurementMode, Mode=TwoWay}" MinWidth="160" Margin="0,0,6,6" AutomationProperties.Name="Pulse measurement source" /><ComboBox ItemsSource="{Binding ActiveAudio.ReferenceNames}" SelectedIndex="{Binding ActiveAudio.ReferenceIndex, Mode=TwoWay}" MinWidth="160" Margin="0,0,6,6" AutomationProperties.Name="Pulse comparison reference" /><CheckBox Content="Follow block" IsChecked="{Binding ActiveAudio.FollowReference, Mode=TwoWay}" /><CheckBox Content="Show reference" IsChecked="{Binding ActiveAudio.ShowReference, Mode=TwoWay}" /><Button Content="User reference…" Command="{Binding AudioReferenceCommand}" /></WrapPanel>
     <WrapPanel Grid.Row="1"><CheckBox Content="SHORT High" IsChecked="{Binding ActiveAudio.ShortHigh, Mode=TwoWay}" Foreground="{DynamicResource F2.pulse-sh}" /><CheckBox Content="SHORT Low" IsChecked="{Binding ActiveAudio.ShortLow, Mode=TwoWay}" Foreground="{DynamicResource F2.pulse-sl}" /><CheckBox Content="LONG High" IsChecked="{Binding ActiveAudio.LongHigh, Mode=TwoWay}" Foreground="{DynamicResource F2.pulse-lh}" /><CheckBox Content="LONG Low" IsChecked="{Binding ActiveAudio.LongLow, Mode=TwoWay}" Foreground="{DynamicResource F2.pulse-ll}" /></WrapPanel>
     <TableView Grid.Row="2" ItemsSource="{Binding ActiveAudio.Distributions}" AutomationProperties.Name="Pulse duration statistics"><TableView.Columns><TableViewColumn Header="Group" Binding="{ReflectionBinding Group}" Width="*" /><TableViewColumn Header="Count" Binding="{ReflectionBinding Count}" Width="85" /><TableViewColumn Header="Mean µs" Binding="{ReflectionBinding Mean}" Width="100" /><TableViewColumn Header="Median µs" Binding="{ReflectionBinding Median}" Width="100" /><TableViewColumn Header="Stddev µs" Binding="{ReflectionBinding StdDev}" Width="100" /><TableViewColumn Header="Ref µs" Binding="{ReflectionBinding Reference}" Width="100" /></TableView.Columns></TableView>
     <WrapPanel Grid.Row="3"><ComboBox x:Name="PulseKind" SelectedIndex="{Binding ActiveAudio.PulseViewIndex, Mode=TwoWay}" SelectionChanged="PulseKindChanged" AutomationProperties.Name="Pulse chart"><ComboBoxItem Content="Histogram" /><ComboBoxItem Content="High / Low scatter" /><ComboBoxItem Content="Drift / variation" /></ComboBox><Button Content="Zoom +" Click="PulseZoomIn" Margin="6,0" /><Button Content="Zoom −" Click="PulseZoomOut" Margin="0,0,6,0" /><Button Content="Fit" Click="PulseFit" /><Button Content="Graph detail" Click="OpenPulseGraph" Margin="6,0" /></WrapPanel>
     <c:AudioChart Grid.Row="4" x:Name="PulseChart" Kind="Histogram" Session="{Binding ActiveAudio}" AutomationProperties.Name="Pulse histogram scatter or drift" />
    </Grid></TabItem>
    <TabItem Header="Regions"><TableView x:Name="AudioRegions" ItemsSource="{Binding ActiveAudio.Regions}" SelectionMode="Multiple" AutoScrollToSelectedItem="False" Margin="0,8,0,0" IsEnabled="{Binding CanUseAudio}" AutomationProperties.Name="Audio regions"><TableView.Columns><TableViewColumn Header="Kind" Binding="{ReflectionBinding Kind}" Width="150" /><TableViewColumn Header="Start frame" Binding="{ReflectionBinding Start}" Width="110" /><TableViewColumn Header="End frame" Binding="{ReflectionBinding End}" Width="110" /><TableViewColumn Header="Ch" Binding="{ReflectionBinding Channel}" Width="40" /><TableViewColumn Header="Evidence" Binding="{ReflectionBinding Evidence}" Width="*" /></TableView.Columns></TableView></TabItem>
    <TabItem Header="Levels / agreement"><Grid RowDefinitions="180,*" RowSpacing="8" Margin="0,8,0,0"><TableView ItemsSource="{Binding ActiveAudio.Levels}" SelectionChanged="LevelSelected" AutomationProperties.Name="Measured PCM levels"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="*" /><TableViewColumn Header="Peak FS" Binding="{ReflectionBinding Peak}" Width="100" /><TableViewColumn Header="RMS FS" Binding="{ReflectionBinding Rms}" Width="100" /><TableViewColumn Header="DC FS" Binding="{ReflectionBinding Dc}" Width="100" /><TableViewColumn Header="Clipping %" Binding="{ReflectionBinding Clipping}" Width="100" /><TableViewColumn Header="Records" Binding="{ReflectionBinding Records}" Width="80" /></TableView.Columns></TableView><TableView Grid.Row="1" ItemsSource="{Binding ActiveAudio.Agreement}" AutomationProperties.Name="Decoder agreement"><TableView.Columns><TableViewColumn Header="Ch" Binding="{ReflectionBinding Channel}" Width="40" /><TableViewColumn Header="Zero valid" Binding="{ReflectionBinding ZeroBlocks}" Width="85" /><TableViewColumn Header="Schmitt valid" Binding="{ReflectionBinding SchmittBlocks}" Width="100" /><TableViewColumn Header="Common" Binding="{ReflectionBinding Common}" Width="90" /><TableViewColumn Header="Agreement %" Binding="{ReflectionBinding Agreement}" Width="110" /><TableViewColumn Header="Definition" Binding="{ReflectionBinding Definition}" Width="*" /></TableView.Columns></TableView></Grid></TabItem>
    <TabItem Header="Spectrum"><Grid RowDefinitions="Auto,Auto,280,Auto" RowSpacing="8" Margin="0,8,0,0"><WrapPanel><ComboBox ItemsSource="{Binding ActiveAudio.FftChoices}" SelectedItem="{Binding ActiveAudio.FftSize, Mode=TwoWay}" Width="100" AutomationProperties.Name="FFT window size" /><Button Content="Compute spectrum" Command="{Binding AudioSpectrumCommand}" Margin="6,0" /><Button Content="Compute spectrogram" Command="{Binding AudioSpectrogramCommand}" Margin="0,0,6,0" /><ComboBox x:Name="SpectralKind" SelectedIndex="{Binding ActiveAudio.SpectralViewIndex, Mode=TwoWay}" SelectionChanged="SpectralKindChanged" AutomationProperties.Name="Spectral view"><ComboBoxItem Content="Spectrum" /><ComboBoxItem Content="Spectrogram" /></ComboBox></WrapPanel><WrapPanel Grid.Row="1"><Button Content="Zoom +" Click="SpectralZoomIn" Margin="0,0,6,0" /><Button Content="Zoom −" Click="SpectralZoomOut" Margin="0,0,6,0" /><Button Content="Fit" Click="SpectralFit" /><Button Content="Graph detail" Click="OpenSpectralGraph" Margin="6,0" /></WrapPanel><c:AudioChart Grid.Row="2" x:Name="SpectrumChart" Kind="Spectrum" Session="{Binding ActiveAudio}" AutomationProperties.Name="Spectrum or spectrogram with exact analysis interval" /><TextBlock Grid.Row="3" Text="{Binding ActiveAudio.SpectralSummary}" Classes="muted" TextWrapping="Wrap" /></Grid></TabItem>
    <TabItem Header="Recovery"><Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0"><StackPanel Spacing="8"><TextBlock Text="{Binding ActiveAudio.RecoverySummary}" TextWrapping="Wrap" /><WrapPanel><Button Content="Deeper analysis…" Command="{Binding AudioRecoverCommand}" Margin="0,0,6,6" /><Button Content="Send to Tape…" Command="{Binding AudioSendTapeCommand}" Margin="0,0,6,6" /><Button Content="Send to QuickDisk…" Command="{Binding AudioSendQuickDiskCommand}" Margin="0,0,6,6" /><Button Content="Raw candidate…" Command="{Binding AudioCandidateExportCommand}" Margin="0,0,6,6" /><Button Content="Synthetic header…" Command="{Binding AudioSyntheticCommand}" /></WrapPanel></StackPanel>
     <TabControl Grid.Row="1" x:Name="RecoveryTabs"><TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
      <TabItem Header="Programs"><TableView x:Name="RecoveryPrograms" ItemsSource="{Binding ActiveAudio.Programs}" SelectedItem="{Binding ActiveAudio.SelectedProgram, Mode=TwoWay}" AutomationProperties.Name="Complete recovered programs"><TableView.Columns><TableViewColumn Header="Name" Binding="{ReflectionBinding Name}" Width="*" /><TableViewColumn Header="Type" Binding="{ReflectionBinding Type}" Width="70" /><TableViewColumn Header="Load" Binding="{ReflectionBinding Load}" Width="80" /><TableViewColumn Header="Execute" Binding="{ReflectionBinding Execute}" Width="80" /><TableViewColumn Header="Bytes" Binding="{ReflectionBinding Size}" Width="100" /><TableViewColumn Header="Profile" Binding="{ReflectionBinding Profile}" Width="150" /></TableView.Columns></TableView></TabItem>
      <TabItem Header="Candidates"><Grid RowDefinitions="*,120"><TableView x:Name="RecoveryCandidates" ItemsSource="{Binding ActiveAudio.Candidates}" SelectedItem="{Binding ActiveAudio.SelectedCandidate, Mode=TwoWay}" AutomationProperties.Name="Recovery candidates with explicit validity"><TableView.Columns><TableViewColumn Header="Kind" Binding="{ReflectionBinding Kind}" Width="80" /><TableViewColumn Header="Status" Binding="{ReflectionBinding Status}" Width="2*" /><TableViewColumn Header="Bytes" Binding="{ReflectionBinding Bytes}" Width="80" /><TableViewColumn Header="Start" Binding="{ReflectionBinding Start}" Width="100" /><TableViewColumn Header="End" Binding="{ReflectionBinding End}" Width="100" /><TableViewColumn Header="Detector" Binding="{ReflectionBinding Detector}" Width="*" /></TableView.Columns></TableView><TextBox Grid.Row="1" Text="{Binding ActiveAudio.CandidateHex}" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace" AutomationProperties.Name="Raw candidate hex and evidence" /></Grid></TabItem>
      <TabItem Header="Passes"><Grid RowDefinitions="*,Auto"><TableView ItemsSource="{Binding ActiveAudio.Passes}" SelectedItem="{Binding ActiveAudio.SelectedPass, Mode=TwoWay}" AutomationProperties.Name="Recovery passes"><TableView.Columns><TableViewColumn Header="Test" Binding="{ReflectionBinding Test}" Width="*" /><TableViewColumn Header="Detectors" Binding="{ReflectionBinding Detectors}" Width="2*" /><TableViewColumn Header="Gate" Binding="{ReflectionBinding Threshold}" Width="75" /><TableViewColumn Header="Headers" Binding="{ReflectionBinding Headers}" Width="75" /><TableViewColumn Header="Payloads" Binding="{ReflectionBinding Payloads}" Width="75" /></TableView.Columns></TableView><ComboBox Grid.Row="1" ItemsSource="{Binding ActiveAudio.RecoveryStreams}" SelectedIndex="{Binding ActiveAudio.RecoveryStreamIndex, Mode=TwoWay}" AutomationProperties.Name="Consumed pulse stream for histogram" /></Grid></TabItem>
      <TabItem Header="Diagnostics"><TableView ItemsSource="{Binding ActiveAudio.Diagnostics}" SelectionChanged="DiagnosticSelected" AutomationProperties.Name="Bounded recovery diagnostics"><TableView.Columns><TableViewColumn Header="Stage" Binding="{ReflectionBinding Stage}" Width="100" /><TableViewColumn Header="Frame" Binding="{ReflectionBinding Frame}" Width="100" /><TableViewColumn Header="Code" Binding="{ReflectionBinding Code}" Width="150" /><TableViewColumn Header="Reason" Binding="{ReflectionBinding Reason}" Width="*" /></TableView.Columns></TableView></TabItem>
      <TabItem Header="Rejected headers"><TableView ItemsSource="{Binding ActiveAudio.RejectedHeaders}" AutomationProperties.Name="Rejected recovered headers"><TableView.Columns><TableViewColumn Header="Frame" Binding="{ReflectionBinding Frame}" Width="110" /><TableViewColumn Header="Ch" Binding="{ReflectionBinding Channel}" Width="45" /><TableViewColumn Header="Detector" Binding="{ReflectionBinding Detector}" Width="150" /><TableViewColumn Header="Reason" Binding="{ReflectionBinding Reason}" Width="*" /></TableView.Columns></TableView></TabItem>
      <TabItem Header="Failures"><TableView ItemsSource="{Binding ActiveAudio.Failures}" SelectionChanged="FailureSelected" AutomationProperties.Name="Unresolved recovery intervals"><TableView.Columns><TableViewColumn Header="Start" Binding="{ReflectionBinding Start}" Width="100" /><TableViewColumn Header="End" Binding="{ReflectionBinding End}" Width="100" /><TableViewColumn Header="Reason" Binding="{ReflectionBinding Reason}" Width="*" /></TableView.Columns></TableView></TabItem>
      <TabItem Header="Compare"><Grid RowDefinitions="Auto,Auto,*"><WrapPanel><ComboBox ItemsSource="{Binding ActiveAudio.PassNames}" SelectedIndex="{Binding ActiveAudio.CompareLeft, Mode=TwoWay}" Width="220" AutomationProperties.Name="Left recovery pass" /><ComboBox ItemsSource="{Binding ActiveAudio.PassNames}" SelectedIndex="{Binding ActiveAudio.CompareRight, Mode=TwoWay}" Width="220" AutomationProperties.Name="Right recovery pass" /><Button Content="Compare" Command="{Binding AudioComparePassesCommand}" /></WrapPanel><TextBlock Grid.Row="1" Text="{Binding ActiveAudio.PassComparisonSummary}" TextWrapping="Wrap" /><TableView Grid.Row="2" ItemsSource="{Binding ActiveAudio.PassDifferences}" SelectionChanged="DifferenceSelected" AutomationProperties.Name="Recovery pass differences"><TableView.Columns><TableViewColumn Header="Stage" Binding="{ReflectionBinding Stage}" Width="110" /><TableViewColumn Header="Status" Binding="{ReflectionBinding Status}" Width="100" /><TableViewColumn Header="Frame" Binding="{ReflectionBinding Frame}" Width="100" /><TableViewColumn Header="Left" Binding="{ReflectionBinding Left}" Width="*" /><TableViewColumn Header="Right" Binding="{ReflectionBinding Right}" Width="*" /><TableViewColumn Header="Evidence" Binding="{ReflectionBinding Evidence}" Width="2*" /></TableView.Columns></TableView></Grid></TabItem>
     </TabControl>
    </Grid></TabItem>
    <TabItem Header="Issues"><Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0"><ComboBox ItemsSource="{Binding ActiveAudio.IssueFilters}" SelectedItem="{Binding ActiveAudio.IssueFilter, Mode=TwoWay}" AutomationProperties.Name="Audio finding severity" /><TableView Grid.Row="1" x:Name="AudioIssues" ItemsSource="{Binding ActiveAudio.Issues}" SelectedItem="{Binding ActiveAudio.SelectedIssue, Mode=TwoWay}" AutoScrollToSelectedItem="False" AutomationProperties.Name="Audio findings"><TableView.Columns><TableViewColumn Header="Severity" Binding="{ReflectionBinding Severity}" Width="80" /><TableViewColumn Header="Code" Binding="{ReflectionBinding Code}" Width="170" /><TableViewColumn Header="Start" Binding="{ReflectionBinding Start}" Width="100" /><TableViewColumn Header="End" Binding="{ReflectionBinding End}" Width="100" /><TableViewColumn Header="Finding" Binding="{ReflectionBinding Description}" Width="*" /></TableView.Columns></TableView></Grid></TabItem>
    <TabItem Header="Report"><c:ReportViewer Text="{Binding ActiveAudio.Report}" Margin="0,8,0,0" /></TabItem>
    <TabItem Header="Definitions"><c:ReportViewer Text="{Binding ActiveAudio.Limits}" Margin="0,8,0,0" /></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Column="2" x:Name="AudioInspectorPanel" Classes="panel"><c:AudioInspector x:Name="Inspector" /></Border>
 </Grid>
</UserControl>
