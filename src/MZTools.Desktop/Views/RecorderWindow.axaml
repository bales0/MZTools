<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:cap="using:MZTools.Capture" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Views.RecorderWindow" x:DataType="vm:RecorderModel" Title="Record Audio / Live Tape Analysis" Width="1220" Height="900" MinWidth="920" MinHeight="640">
 <Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="10">
  <StackPanel Spacing="4">
   <Expander Header="Input / recording settings" IsExpanded="True" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="5" IsEnabled="{Binding CanConfigure}">
    <WrapPanel>
     <TextBlock Text="Source" VerticalAlignment="Center" Margin="4" /><ComboBox ItemsSource="{Binding Backends}" SelectedIndex="{Binding BackendIndex, Mode=TwoWay}" Width="220" AutomationProperties.Name="Recorder backend" />
     <TextBlock Text="Device" VerticalAlignment="Center" Margin="8,4,4,4" /><ComboBox x:Name="InputDevices" ItemsSource="{Binding Devices}" SelectedItem="{Binding Device, Mode=TwoWay}" Width="230" AutomationProperties.Name="Explicit input device"><ComboBox.ItemTemplate><DataTemplate x:DataType="cap:AudioCaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <TextBlock Text="Input format" VerticalAlignment="Center" Margin="8,4,4,4" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=TwoWay}" MinWidth="250" AutomationProperties.Name="Requested PCM format"><ComboBox.ItemTemplate><DataTemplate x:DataType="cap:AudioCaptureFormat"><TextBlock><Run Text="{Binding SampleRate}" /><Run Text=" Hz / " /><Run Text="{Binding BitsPerSample}" /><Run Text=" bit (" /><Run Text="{Binding ValidBitsPerSample}" /><Run Text=" valid) / " /><Run Text="{Binding Channels}" /><Run Text=" ch / " /><Run Text="{Binding Representation}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <Button x:Name="EnumerateInputs" Content="Refresh inputs" Click="Enumerate" Margin="6,0" />
    </WrapPanel>
    <WrapPanel><CheckBox Content="Request RAW (shared only)" IsChecked="{Binding Raw, Mode=TwoWay}" Margin="4" /><CheckBox Content="Allow Windows format conversion" IsChecked="{Binding EngineConversion, Mode=TwoWay}" Margin="4" /><CheckBox Content="Allow float32 / PCM32 → PCM24" IsChecked="{Binding AllowPcm24, Mode=TwoWay}" Margin="4" /><CheckBox Content="Preserve native PCM/float" IsChecked="{Binding PreserveNative, Mode=TwoWay}" Margin="4" /><CheckBox Content="Allow reported format fallback" IsChecked="{Binding AllowFallback, Mode=TwoWay}" Margin="4" /></WrapPanel>
     <Expander Header="Probe an exact format (does not start recording)"><WrapPanel>
      <TextBlock Text="Custom native Hz" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox x:Name="RecorderProbeRate" Text="192000" Width="80" />
      <TextBlock Text="Container" VerticalAlignment="Center" Margin="8,0,4,0" /><ComboBox x:Name="RecorderProbeEncoding" SelectedIndex="2" Width="105"><ComboBoxItem Content="Unsigned8" /><ComboBoxItem Content="Signed16" /><ComboBoxItem Content="Signed24" /><ComboBoxItem Content="Signed32" /><ComboBoxItem Content="Float32" /></ComboBox>
      <TextBlock Text="Valid bits" VerticalAlignment="Center" Margin="8,0,4,0" /><TextBox x:Name="RecorderProbeBits" Text="24" Width="45" />
      <TextBlock Text="Channels" VerticalAlignment="Center" Margin="8,0,4,0" /><ComboBox x:Name="RecorderProbeChannels" SelectedIndex="1" Width="75"><ComboBoxItem Content="Mono" /><ComboBoxItem Content="Stereo" /></ComboBox>
      <Button Content="Probe format" Click="ProbeFormat" Margin="8,0" />
     </WrapPanel></Expander>
    <WrapPanel><TextBlock Text="WAV destination" VerticalAlignment="Center" Margin="4" /><TextBox x:Name="RecorderDestination" Width="400" AutomationProperties.Name="WAV destination" /><Button Content="Browse…" Click="BrowseRecording" Margin="4,0" /></WrapPanel>
    <WrapPanel><TextBlock Text="Tape note" VerticalAlignment="Center" Margin="4" /><TextBox Text="{Binding Note, Mode=TwoWay}" Width="200" AutomationProperties.Name="Recording tape note" /><TextBlock Text="Side" VerticalAlignment="Center" Margin="8,4,4,4" /><TextBox Text="{Binding TapeSide, Mode=TwoWay}" Width="65" AutomationProperties.Name="Recording tape side" /></WrapPanel>
   </StackPanel></ScrollViewer></Expander>
   <WrapPanel><Button x:Name="MonitorInput" Content="Monitor only" Click="Monitor" IsEnabled="{Binding CanMonitor}" Margin="4" /><Button x:Name="RecordInput" Content="Record" Click="Record" IsEnabled="{Binding CanStart}" Margin="4" /><Button x:Name="StopInput" Content="Stop / finalize" Click="Stop" IsEnabled="{Binding CanStop}" Margin="4" /><Button Content="Cancel" Click="Discard" IsEnabled="{Binding CanDiscard}" Margin="4" /><Button Content="Cancel operation" Click="CancelOperation" IsVisible="{Binding IsBusy}" Margin="4" /></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="4" /><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="Firebrick" TextWrapping="Wrap" Margin="4" />
   <Expander Header="Actual input / processing"><TextBlock Text="{Binding Processing}" TextWrapping="Wrap" Margin="8" /></Expander>
  </StackPanel>
  <TabControl Grid.Row="1" x:Name="RecorderTabs" SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
   <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
   <TabItem Header="Live signal"><Grid RowDefinitions="83,Auto,Auto,*" RowSpacing="5" Margin="4">
    <TableView ToolTip.Tip="{Binding SelectionSummary}" ItemsSource="{Binding Live.Levels}" AutomationProperties.Name="Live PCM levels"><TableView.Columns>
     <TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="70" /><TableViewColumn Header="Peak FS" Binding="{ReflectionBinding Peak,StringFormat=F4}" Width="85" /><TableViewColumn Header="RMS FS" Binding="{ReflectionBinding Rms,StringFormat=F4}" Width="85" /><TableViewColumn Header="DC FS" Binding="{ReflectionBinding Dc,StringFormat=F4}" Width="85" /><TableViewColumn Header="Peak dBFS" Binding="{ReflectionBinding PeakDbfs,StringFormat=F2}" Width="90" /><TableViewColumn Header="RMS dBFS" Binding="{ReflectionBinding RmsDbfs,StringFormat=F2}" Width="90" /><TableViewColumn Header="Clip count" Binding="{ReflectionBinding ClippedSamples}" Width="85" /><TableViewColumn Header="Clip hold" Binding="{ReflectionBinding ClippingHold}" Width="85" /><TableViewColumn Header="Clipped %" Binding="{ReflectionBinding ClippingPercent,StringFormat=F3}" Width="85" />
    </TableView.Columns></TableView>
    <WrapPanel Grid.Row="1"><TextBlock Text="View" VerticalAlignment="Center" Margin="4" /><ComboBox ItemsSource="{Binding Channels}" SelectedIndex="{Binding ChannelMode, Mode=TwoWay}" MinWidth="90" AutomationProperties.Name="Live displayed channels" /><TextBlock Text="Gain" VerticalAlignment="Center" Margin="8,4,4,4" /><ComboBox ItemsSource="{Binding GainChoices}" SelectedItem="{Binding Gain, Mode=TwoWay}" Width="75" AutomationProperties.Name="Live display gain" /><CheckBox Content="Auto scale" IsChecked="{Binding AutoScale, Mode=TwoWay}" Margin="8,0" /><CheckBox Content="Follow live" IsChecked="{Binding FollowLive, Mode=TwoWay}" Margin="4" /><Button Content="Fit history" Click="FitWave" Margin="4" /><Button Content="Zoom +" Click="ZoomLiveIn" Margin="4" /><Button Content="Zoom −" Click="ZoomLiveOut" Margin="4" /></WrapPanel>
    <WrapPanel Grid.Row="2"><CheckBox Content="Trigger" IsChecked="{Binding TriggerEnabled, Mode=TwoWay}" Margin="4" /><TextBlock Text="Level (FS)" VerticalAlignment="Center" Margin="4" /><TextBox Text="{Binding TriggerLevel, Mode=TwoWay}" Width="55" AutomationProperties.Name="Live trigger level FS" /><ComboBox ItemsSource="{Binding TriggerSlopes}" SelectedIndex="{Binding TriggerSlopeIndex, Mode=TwoWay}" Width="85" Margin="8,0" /><TextBlock Text="FFT" VerticalAlignment="Center" Margin="4" /><ComboBox ItemsSource="{Binding FftChoices}" SelectedItem="{Binding FftSize, Mode=TwoWay}" Width="85" AutomationProperties.Name="Live FFT size" /><TextBlock Text="Clip ≥ % FS" VerticalAlignment="Center" Margin="8,4,4,4" /><TextBox Text="{Binding ClipThreshold, Mode=TwoWay}" Width="50" AutomationProperties.Name="Clip threshold percent FS" /><Button Content="Apply / reset clip hold" Click="ResetClipping" Margin="4" /></WrapPanel>
    <Grid Grid.Row="3" RowDefinitions="3*,5,2*"><c:AudioChart x:Name="LiveWave" Kind="Waveform" LiveSnapshot="{Binding Live}" LiveChannel="{Binding ChannelMode}" LiveAutoScale="{Binding AutoScale}" LiveGain="{Binding Gain}" LiveSelectionStart="{Binding SelectionStart}" LiveSelectionEnd="{Binding SelectionEnd}" MinHeight="80" AutomationProperties.Name="Live waveform from copied Capture snapshot" /><GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="LightGray" /><c:AudioChart Grid.Row="2" Kind="Spectrum" LiveSnapshot="{Binding Live}" LiveChannel="{Binding ChannelMode}" MinHeight="70" AutomationProperties.Name="Live amplitude FFT spectrum" /></Grid>
   </Grid></TabItem>
<TabItem Header="Recordings"><Grid RowDefinitions="*,Auto,Auto" RowSpacing="10" Margin="0,8,0,0"><TableView x:Name="SavedRecordings" ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording, Mode=TwoWay}" AutomationProperties.Name="Finalized recording history"><TableView.Columns><TableViewColumn Header="Start UTC" Binding="{ReflectionBinding StartUtc}" Width="*" /><TableViewColumn Header="Integrity" Binding="{ReflectionBinding Integrity}" Width="130" /><TableViewColumn Header="End reason" Binding="{ReflectionBinding Reason}" Width="150" /><TableViewColumn Header="Saved frames" Binding="{ReflectionBinding Recording.SavedFrames}" Width="140" /><TableViewColumn Header="Manifest" Binding="{ReflectionBinding Recording.SidecarPath}" Width="2*" /></TableView.Columns></TableView><WrapPanel Grid.Row="1"><Button Content="Visual analysis" Click="OpenVisual" Margin="0,0,8,0" /><Button Content="Heuristic import" Click="OpenHeuristic" Margin="0,0,8,0" /><Button Content="Manual recovery" Click="OpenRecovery" Margin="0,0,8,0" /><Button Content="Reveal recording" Click="Reveal" /></WrapPanel><c:ReportViewer MaxHeight="120" Grid.Row="2" Text="{Binding RecordingDetails}" /></Grid></TabItem>
<TabItem Header="Diagnostics"><c:ReportViewer Text="{Binding DiagnosticsSummary}" Margin="6" /></TabItem>
<TabItem Header="Head alignment"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10" Margin="0,8,0,0"><WrapPanel><CheckBox Content="Enable alignment diagnostics" IsChecked="{Binding AlignmentEnabled, Mode=TwoWay}" /><NumericUpDown Value="{Binding BandLow, Mode=TwoWay}" Minimum="1" Maximum="90000" Width="110" Margin="8,0" AutomationProperties.Name="Alignment low band Hz" /><NumericUpDown Value="{Binding BandSplit, Mode=TwoWay}" Minimum="1" Maximum="90000" Width="110" AutomationProperties.Name="Alignment split band Hz" /><NumericUpDown Value="{Binding BandHigh, Mode=TwoWay}" Minimum="1" Maximum="96000" Width="110" Margin="8,0" AutomationProperties.Name="Alignment high band Hz" /><TextBox Text="{Binding KnownTone, Mode=TwoWay}" PlaceholderText="Known tone Hz (optional)" Width="190" AutomationProperties.Name="Known reference tone Hz" /><NumericUpDown Value="{Binding MaximumLag, Mode=TwoWay}" Minimum="1" Maximum="128" Width="90" Margin="8,0" AutomationProperties.Name="Maximum lag samples" /></WrapPanel><WrapPanel><Button Content="Zero here" Click="ZeroEdges" IsEnabled="{Binding CanZeroEdges}" Margin="0,0,8,0" /><Button Content="Clear zero" Click="ClearEdges" /><TextBlock Text="Damping s" Margin="8,0,4,0" VerticalAlignment="Center" /><NumericUpDown Value="{Binding EdgeDamping, Mode=TwoWay}" Minimum="0.1" Maximum="3" Increment="0.1" Width="95" AutomationProperties.Name="Edge display damping seconds" /><TextBlock Text="Dial ±%" Margin="8,0,4,0" VerticalAlignment="Center" /><NumericUpDown Value="{Binding EdgeRange, Mode=TwoWay}" Minimum="1" Maximum="1000" Width="95" AutomationProperties.Name="Relative edge dial range percent" /><CheckBox Content="Same tape section replayed" IsChecked="{Binding SameSection, Mode=TwoWay}" Margin="8,0" /><TextBox Text="{Binding CopyLabel, Mode=TwoWay}" PlaceholderText="Tape copy / section" Width="220" AutomationProperties.Name="Session-local tape copy label" /></WrapPanel><c:AudioChart Kind="HeadEdges" EdgeLeft="{Binding LeftEdge}" EdgeRight="{Binding RightEdge}" EdgeRange="{Binding EdgeRange}" Height="360" AutomationProperties.Name="Per-channel relative edges from manual zero, not mechanical angle" /><TextBlock Text="{Binding LeftEdge.Message}" TextWrapping="Wrap" Classes="muted" /><TextBlock Text="{Binding RightEdge.Message}" TextWrapping="Wrap" Classes="muted" /><Expander Header="Edge qualification / diagnostic details" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><TextBlock Text="{Binding LeftEdge.Diagnostics}" TextWrapping="Wrap" /><TextBlock Text="{Binding RightEdge.Diagnostics}" TextWrapping="Wrap" /><TextBlock Text="{Binding AlignmentDetails}" TextWrapping="Wrap" Classes="muted" /><TableView ItemsSource="{Binding AlignmentChannels}" Height="180" AutomationProperties.Name="Alignment qualification and per-channel measurements"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="90" /><TableViewColumn Header="Assessable" Binding="{ReflectionBinding Assessable}" Width="100" /><TableViewColumn Header="Qualification" Binding="{ReflectionBinding Quality}" Width="2*" /><TableViewColumn Header="AC RMS" Binding="{ReflectionBinding AcRms}" Width="100" /><TableViewColumn Header="High band %" Binding="{ReflectionBinding HighBandPercent}" Width="110" /><TableViewColumn Header="Slope /ms" Binding="{ReflectionBinding NormalizedSlopePerMs}" Width="110" /><TableViewColumn Header="Rise µs" Binding="{ReflectionBinding RiseMicroseconds}" Width="100" /><TableViewColumn Header="Fall µs" Binding="{ReflectionBinding FallMicroseconds}" Width="100" /></TableView.Columns></TableView><c:AudioChart Kind="StereoIndicator" LiveSnapshot="{Binding Live}" Height="280" AutomationProperties.Name="Qualified stereo signal phase and delay, not mechanical angle" /><TableView ItemsSource="{Binding StereoRows}" Height="230" AutomationProperties.Name="Stereo evidence and qualification"><TableView.Columns><TableViewColumn Header="Metric" Binding="{ReflectionBinding Metric}" Width="200" /><TableViewColumn Header="Value" Binding="{ReflectionBinding Value}" Width="180" /><TableViewColumn Header="Meaning" Binding="{ReflectionBinding Meaning}" Width="*" /></TableView.Columns></TableView><WrapPanel><TextBox Text="{Binding Passage, Mode=TwoWay}" PlaceholderText="Same named reference passage" Width="320" AutomationProperties.Name="Alignment A/B reference passage" /><CheckBox Content="I confirm replay of this same passage" IsChecked="{Binding SamePassage, Mode=TwoWay}" Margin="8,0" /><Button Content="Save A" Click="SaveA" IsEnabled="{Binding CanSaveAlignment}" Margin="0,0,8,0" /><Button Content="Save B" Click="SaveB" IsEnabled="{Binding CanSaveAlignment}" /><Button Content="Clear A/B" Click="ClearComparison" Margin="8,0" /></WrapPanel><TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" /><c:AudioChart Kind="Alignment" Comparison="{Binding Comparison}" Height="360" AutomationProperties.Name="A and B relative graph with qualified original metric units" /><TableView ItemsSource="{Binding Differences}" Height="230" AutomationProperties.Name="Qualified A/B differences, no combined score"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="100" /><TableViewColumn Header="Metric" Binding="{ReflectionBinding Metric}" Width="*" /><TableViewColumn Header="Unit" Binding="{ReflectionBinding Unit}" Width="100" /><TableViewColumn Header="A" Binding="{ReflectionBinding A}" Width="140" /><TableViewColumn Header="B" Binding="{ReflectionBinding B}" Width="140" /><TableViewColumn Header="Δ B−A" Binding="{ReflectionBinding Delta}" Width="140" /></TableView.Columns></TableView></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Live pulses"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10" Margin="0,8,0,0"><WrapPanel><CheckBox Content="Enable pulse diagnostics" IsChecked="{Binding PulsesEnabled, Mode=TwoWay}" /><ComboBox ItemsSource="{Binding PulseReferences}" SelectedIndex="{Binding PulseReferenceIndex, Mode=TwoWay}" Width="300" Margin="8,0" AutomationProperties.Name="Live pulse catalog reference" /><Button Content="User reference…" Click="UserReference" Margin="0,0,8,0" /><Button Content="Apply pulse settings" Click="ApplyPulses" /></WrapPanel><WrapPanel><CheckBox Content="Zero" IsChecked="{Binding PulseZero, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Schmitt" IsChecked="{Binding PulseSchmitt, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Adaptive" IsChecked="{Binding PulseAdaptive, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Invert comparison" IsChecked="{Binding PulseInvert, Mode=TwoWay}" /><NumericUpDown Value="{Binding PulseThreshold, Mode=TwoWay}" Minimum="0.1" Maximum="4" Increment="0.1" Width="95" Margin="8,0" AutomationProperties.Name="Pulse threshold scale" /><NumericUpDown Value="{Binding PulseDeadband, Mode=TwoWay}" Minimum="0" Maximum="100" Width="95" AutomationProperties.Name="Pulse deadband percent FS" /><NumericUpDown Value="{Binding PulseTolerance, Mode=TwoWay}" Minimum="0" Maximum="100" Width="95" Margin="8,0" AutomationProperties.Name="Pulse reference tolerance percent" /><TextBlock Text="Window s" VerticalAlignment="Center" Margin="8,0,4,0" /><NumericUpDown Value="{Binding PulseWindowSeconds, Mode=TwoWay}" Minimum="0.05" Maximum="10" Increment="0.25" Width="95" AutomationProperties.Name="Pulse measurement window seconds" /><CheckBox Content="Reference guides" IsChecked="{Binding ShowPulseReference, Mode=TwoWay}" Margin="8,0" /><NumericUpDown Value="{Binding PulseScale, Mode=TwoWay}" Minimum="0.1" Maximum="10" Increment="0.01" Width="95" AutomationProperties.Name="Pulse reference scale" /></WrapPanel><WrapPanel><ComboBox ItemsSource="{Binding PulseDetectors}" SelectedIndex="{Binding PulseDetector, Mode=TwoWay}" Width="200" AutomationProperties.Name="One consumed pulse detector stream" /><NumericUpDown Value="{Binding PulseChannel, Mode=TwoWay}" Minimum="0" Maximum="{Binding PulseMaximumChannel}" Width="85" Margin="8,0" AutomationProperties.Name="Pulse channel zero-based" /><Button Content="Fit references" Click="FitPulseReferences" Margin="0,0,8,0" /><Button Content="Histogram fit" Click="FitPulse" /></WrapPanel><c:AudioChart x:Name="LivePulses" Height="260" Kind="Histogram" ShowLiveReference="{Binding ShowPulseReference}" LiveSnapshot="{Binding Live}" AutomationProperties.Name="Live duration histogram" /><TableView ItemsSource="{Binding PulseDistributions}" Height="160" AutomationProperties.Name="Live pulse group statistics"><TableView.Columns><TableViewColumn Header="Group" Binding="{ReflectionBinding Group}" Width="*" /><TableViewColumn Header="Count" Binding="{ReflectionBinding Count}" Width="100" /><TableViewColumn Header="Mean µs" Binding="{ReflectionBinding MeanMicroseconds}" Width="120" /><TableViewColumn Header="Stddev µs" Binding="{ReflectionBinding StandardDeviationMicroseconds}" Width="120" /><TableViewColumn Header="CV %" Binding="{ReflectionBinding CvPercent}" Width="100" /></TableView.Columns></TableView><TabControl Height="220"><TabItem Header="Timing windows"><TableView ItemsSource="{Binding PulseTiming}" AutomationProperties.Name="Live reference timing windows"><TableView.Columns><TableViewColumn Header="Start frame" Binding="{ReflectionBinding StartFrame}" Width="140" /><TableViewColumn Header="End frame" Binding="{ReflectionBinding EndFrame}" Width="140" /><TableViewColumn Header="Matches" Binding="{ReflectionBinding Matches}" Width="100" /><TableViewColumn Header="Timing scale" Binding="{ReflectionBinding MeanTimingScale}" Width="160" /><TableViewColumn Header="Residual RMS %" Binding="{ReflectionBinding ResidualRmsPercent}" Width="180" /></TableView.Columns></TableView></TabItem><TabItem Header="Recent measured pulses"><TableView ItemsSource="{Binding RecentPulses}" AutomationProperties.Name="Recent measured pulses, no decoded bits"><TableView.Columns><TableViewColumn Header="End frame" Binding="{ReflectionBinding EndFrame}" Width="140" /><TableViewColumn Header="Measured µs" Binding="{ReflectionBinding Microseconds}" Width="140" /><TableViewColumn Header="Physical high" Binding="{ReflectionBinding PhysicalHigh}" Width="110" /><TableViewColumn Header="Comparison group" Binding="{ReflectionBinding Group}" Width="160" /><TableViewColumn Header="Reference µs" Binding="{ReflectionBinding ReferenceMicroseconds}" Width="140" /><TableViewColumn Header="Residual %" Binding="{ReflectionBinding ResidualPercent}" Width="120" /><TableViewColumn Header="Match" Binding="{ReflectionBinding ReferenceMatch}" Width="90" /></TableView.Columns></TableView></TabItem></TabControl><TextBlock Text="{Binding PulseDetails}" TextWrapping="Wrap" Classes="muted" /><TableView ItemsSource="{Binding PulseStreams}" Height="160" AutomationProperties.Name="Separate live detector streams"><TableView.Columns><TableViewColumn Header="Detector" Binding="{ReflectionBinding Detector}" Width="*" /><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="100" /><TableViewColumn Header="Detected" Binding="{ReflectionBinding DetectedSinceReset}" Width="110" /><TableViewColumn Header="Retained" Binding="{ReflectionBinding Retained}" Width="100" /><TableViewColumn Header="Evicted" Binding="{ReflectionBinding CapacityEvictions}" Width="100" /></TableView.Columns></TableView></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</Window>
