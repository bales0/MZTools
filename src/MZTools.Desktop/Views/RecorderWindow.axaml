<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MZTools.Desktop.ViewModels" xmlns:cap="using:MZTools.Capture" xmlns:c="using:MZTools.Desktop.Controls" x:Class="MZTools.Desktop.Views.RecorderWindow" x:DataType="vm:RecorderModel" Title="MZTools · Recorder / Head Alignment" Width="1440" Height="960" MinWidth="640" MinHeight="480">
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="20">
  <StackPanel Spacing="8">
   <TextBlock Text="Recorder / Head Alignment" Classes="heading" />
   <TextBlock Text="Explicit input · archive priority · independent recorder window" Classes="muted" />
   <WrapPanel><Button x:Name="EnumerateInputs" Content="Find inputs" Click="Enumerate" IsEnabled="{Binding CanConfigure}" Margin="0,0,6,6" /><Button x:Name="MonitorInput" Content="Monitor" Click="Monitor" IsEnabled="{Binding CanMonitor}" Margin="0,0,6,6" /><Button x:Name="RecordInput" Content="Record WAV…" Click="Record" IsEnabled="{Binding CanStart}" Margin="0,0,6,6" /><Button x:Name="StopInput" Content="Stop / finalize" Click="Stop" IsEnabled="{Binding CanStop}" Margin="0,0,6,6" /><Button Content="Cancel operation" Click="CancelOperation" IsVisible="{Binding IsBusy}" Margin="0,0,6,6" /><Button Content="Discard current run…" Click="Discard" IsEnabled="{Binding CanDiscard}" Margin="0,0,6,6" /><Button Content="Reset clipping hold" Click="ResetClipping" /></WrapPanel>
   <Border IsVisible="{Binding HasError}" Background="{DynamicResource F2.error-bg}" Padding="10"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource F2.error}" TextWrapping="Wrap" /></Border>
  </StackPanel>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
    <Border Classes="panel"><StackPanel Spacing="8" IsEnabled="{Binding CanConfigure}">
     <WrapPanel><StackPanel Width="270" Margin="0,0,8,8"><TextBlock Text="Input backend" /><ComboBox ItemsSource="{Binding Backends}" SelectedIndex="{Binding BackendIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Recorder backend" /></StackPanel><StackPanel Width="320" Margin="0,0,8,8"><TextBlock Text="Input device · no automatic default" /><ComboBox x:Name="InputDevices" ItemsSource="{Binding Devices}" SelectedItem="{Binding Device, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Explicit input device"><ComboBox.ItemTemplate><DataTemplate x:DataType="cap:AudioCaptureDevice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Width="360" Margin="0,0,8,8"><TextBlock Text="Requested delivered format" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Requested PCM format"><ComboBox.ItemTemplate><DataTemplate x:DataType="cap:AudioCaptureFormat"><TextBlock><Run Text="{Binding SampleRate}" /><Run Text=" Hz · " /><Run Text="{Binding Channels}" /><Run Text=" ch · " /><Run Text="{Binding Representation}" /><Run Text=" / valid " /><Run Text="{Binding ValidBitsPerSample}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></WrapPanel>
     <WrapPanel><CheckBox Content="Request RAW (Windows)" IsChecked="{Binding Raw, Mode=TwoWay}" Margin="0,0,12,6" /><CheckBox Content="Allow Windows engine conversion" IsChecked="{Binding EngineConversion, Mode=TwoWay}" Margin="0,0,12,6" /><CheckBox Content="Allow reported format fallback" IsChecked="{Binding AllowFallback, Mode=TwoWay}" /></WrapPanel>
     <WrapPanel><CheckBox Content="Preserve delivered native PCM/float" IsChecked="{Binding PreserveNative, Mode=TwoWay}" Margin="0,0,12,6" /><CheckBox Content="Allow explicit float/PCM32 → PCM24 conversion" IsChecked="{Binding AllowPcm24, Mode=TwoWay}" /></WrapPanel>
     <WrapPanel><TextBox Text="{Binding Note, Mode=TwoWay}" PlaceholderText="Tape note" Width="340" Margin="0,0,8,0" AutomationProperties.Name="Recording tape note" /><TextBox Text="{Binding TapeSide, Mode=TwoWay}" PlaceholderText="Tape side" Width="140" AutomationProperties.Name="Recording tape side" /></WrapPanel>
    </StackPanel></Border>
    <Border Grid.Row="1" Classes="panel"><StackPanel Spacing="6"><TextBlock Text="{Binding Processing}" Classes="muted" TextWrapping="Wrap" /><WrapPanel><ComboBox ItemsSource="{Binding Channels}" SelectedIndex="{Binding ChannelMode, Mode=TwoWay}" MinWidth="140" AutomationProperties.Name="Live displayed channels" /><CheckBox Content="Auto scale" IsChecked="{Binding AutoScale, Mode=TwoWay}" Margin="8,0" /><NumericUpDown Value="{Binding Gain, Mode=TwoWay}" Minimum="0.001" Maximum="1000" Increment="0.25" Width="110" AutomationProperties.Name="Live display gain" /><CheckBox Content="Follow live" IsChecked="{Binding FollowLive, Mode=TwoWay}" Margin="8,0" /><CheckBox Content="Trigger" IsChecked="{Binding TriggerEnabled, Mode=TwoWay}" Margin="8,0" /><NumericUpDown Value="{Binding TriggerLevel, Mode=TwoWay}" Minimum="-1" Maximum="1" Increment="0.05" Width="95" AutomationProperties.Name="Live trigger level FS" /><CheckBox Content="Rising" IsChecked="{Binding RisingTrigger, Mode=TwoWay}" Margin="8,0" /><Button Content="Fit / follow live" Click="FitWave" /><ComboBox ItemsSource="{Binding FftChoices}" SelectedItem="{Binding FftSize, Mode=TwoWay}" Width="100" Margin="8,0" AutomationProperties.Name="Live FFT size" /></WrapPanel></StackPanel></Border>
    <TabControl Grid.Row="2" x:Name="RecorderTabs" SelectedIndex="{Binding TabIndex, Mode=TwoWay}" MinHeight="640">
     <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
     <TabItem Header="Signal"><Grid RowDefinitions="250,250,130" RowSpacing="10" Margin="0,8,0,0"><c:AudioChart x:Name="LiveWave" Kind="Waveform" LiveSnapshot="{Binding Live}" LiveChannel="{Binding ChannelMode}" LiveAutoScale="{Binding AutoScale}" LiveGain="{Binding Gain}" LiveSelectionStart="{Binding SelectionStart}" LiveSelectionEnd="{Binding SelectionEnd}" AutomationProperties.Name="Live waveform from copied Capture snapshot" /><c:AudioChart Grid.Row="1" Kind="Spectrum" LiveSnapshot="{Binding Live}" LiveChannel="{Binding ChannelMode}" AutomationProperties.Name="Live amplitude FFT spectrum" /><TableView Grid.Row="2" ToolTip.Tip="{Binding SelectionSummary}" ItemsSource="{Binding Live.Levels}" AutomationProperties.Name="Live PCM levels"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="*" /><TableViewColumn Header="Peak FS" Binding="{ReflectionBinding Peak}" Width="100" /><TableViewColumn Header="RMS FS" Binding="{ReflectionBinding Rms}" Width="100" /><TableViewColumn Header="DC FS" Binding="{ReflectionBinding Dc}" Width="100" /><TableViewColumn Header="Peak dBFS" Binding="{ReflectionBinding PeakDbfs}" Width="110" /><TableViewColumn Header="RMS dBFS" Binding="{ReflectionBinding RmsDbfs}" Width="110" /><TableViewColumn Header="Clip hold" Binding="{ReflectionBinding ClippingHold}" Width="100" /></TableView.Columns></TableView></Grid></TabItem>
     <TabItem Header="Live pulses"><StackPanel Spacing="10" Margin="0,8,0,0"><WrapPanel><CheckBox Content="Enable pulse diagnostics" IsChecked="{Binding PulsesEnabled, Mode=TwoWay}" /><ComboBox ItemsSource="{Binding PulseReferences}" SelectedIndex="{Binding PulseReferenceIndex, Mode=TwoWay}" Width="300" Margin="8,0" AutomationProperties.Name="Live pulse catalog reference" /><Button Content="User reference…" Click="UserReference" Margin="0,0,8,0" /><Button Content="Apply pulse settings" Click="ApplyPulses" /></WrapPanel><WrapPanel><CheckBox Content="Zero" IsChecked="{Binding PulseZero, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Schmitt" IsChecked="{Binding PulseSchmitt, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Adaptive" IsChecked="{Binding PulseAdaptive, Mode=TwoWay}" Margin="0,0,10,0" /><CheckBox Content="Invert comparison" IsChecked="{Binding PulseInvert, Mode=TwoWay}" /><NumericUpDown Value="{Binding PulseThreshold, Mode=TwoWay}" Minimum="0.1" Maximum="4" Increment="0.1" Width="95" Margin="8,0" AutomationProperties.Name="Pulse threshold scale" /><NumericUpDown Value="{Binding PulseDeadband, Mode=TwoWay}" Minimum="0" Maximum="100" Width="95" AutomationProperties.Name="Pulse deadband percent FS" /><NumericUpDown Value="{Binding PulseTolerance, Mode=TwoWay}" Minimum="0" Maximum="100" Width="95" Margin="8,0" AutomationProperties.Name="Pulse reference tolerance percent" /><TextBlock Text="Window s" VerticalAlignment="Center" Margin="8,0,4,0" /><NumericUpDown Value="{Binding PulseWindowSeconds, Mode=TwoWay}" Minimum="0.05" Maximum="10" Increment="0.25" Width="95" AutomationProperties.Name="Pulse measurement window seconds" /><CheckBox Content="Reference guides" IsChecked="{Binding ShowPulseReference, Mode=TwoWay}" Margin="8,0" /><NumericUpDown Value="{Binding PulseScale, Mode=TwoWay}" Minimum="0.1" Maximum="10" Increment="0.01" Width="95" AutomationProperties.Name="Pulse reference scale" /></WrapPanel><WrapPanel><ComboBox ItemsSource="{Binding PulseDetectors}" SelectedIndex="{Binding PulseDetector, Mode=TwoWay}" Width="200" AutomationProperties.Name="One consumed pulse detector stream" /><NumericUpDown Value="{Binding PulseChannel, Mode=TwoWay}" Minimum="0" Maximum="{Binding PulseMaximumChannel}" Width="85" Margin="8,0" AutomationProperties.Name="Pulse channel zero-based" /><Button Content="Fit references" Click="FitPulseReferences" Margin="0,0,8,0" /><Button Content="Histogram fit" Click="FitPulse" /></WrapPanel><c:AudioChart x:Name="LivePulses" Height="260" Kind="Histogram" ShowLiveReference="{Binding ShowPulseReference}" LiveSnapshot="{Binding Live}" AutomationProperties.Name="Live duration histogram" /><TableView ItemsSource="{Binding PulseDistributions}" Height="160" AutomationProperties.Name="Live pulse group statistics"><TableView.Columns><TableViewColumn Header="Group" Binding="{ReflectionBinding Group}" Width="*" /><TableViewColumn Header="Count" Binding="{ReflectionBinding Count}" Width="100" /><TableViewColumn Header="Mean µs" Binding="{ReflectionBinding MeanMicroseconds}" Width="120" /><TableViewColumn Header="Stddev µs" Binding="{ReflectionBinding StandardDeviationMicroseconds}" Width="120" /><TableViewColumn Header="CV %" Binding="{ReflectionBinding CvPercent}" Width="100" /></TableView.Columns></TableView><TabControl Height="220"><TabItem Header="Timing windows"><TableView ItemsSource="{Binding PulseTiming}" AutomationProperties.Name="Live reference timing windows"><TableView.Columns><TableViewColumn Header="Start frame" Binding="{ReflectionBinding StartFrame}" Width="140" /><TableViewColumn Header="End frame" Binding="{ReflectionBinding EndFrame}" Width="140" /><TableViewColumn Header="Matches" Binding="{ReflectionBinding Matches}" Width="100" /><TableViewColumn Header="Timing scale" Binding="{ReflectionBinding MeanTimingScale}" Width="160" /><TableViewColumn Header="Residual RMS %" Binding="{ReflectionBinding ResidualRmsPercent}" Width="180" /></TableView.Columns></TableView></TabItem><TabItem Header="Recent measured pulses"><TableView ItemsSource="{Binding RecentPulses}" AutomationProperties.Name="Recent measured pulses, no decoded bits"><TableView.Columns><TableViewColumn Header="End frame" Binding="{ReflectionBinding EndFrame}" Width="140" /><TableViewColumn Header="Measured µs" Binding="{ReflectionBinding Microseconds}" Width="140" /><TableViewColumn Header="Physical high" Binding="{ReflectionBinding PhysicalHigh}" Width="110" /><TableViewColumn Header="Comparison group" Binding="{ReflectionBinding Group}" Width="160" /><TableViewColumn Header="Reference µs" Binding="{ReflectionBinding ReferenceMicroseconds}" Width="140" /><TableViewColumn Header="Residual %" Binding="{ReflectionBinding ResidualPercent}" Width="120" /><TableViewColumn Header="Match" Binding="{ReflectionBinding ReferenceMatch}" Width="90" /></TableView.Columns></TableView></TabItem></TabControl><TextBlock Text="{Binding PulseDetails}" TextWrapping="Wrap" Classes="muted" /><TableView ItemsSource="{Binding PulseStreams}" Height="160" AutomationProperties.Name="Separate live detector streams"><TableView.Columns><TableViewColumn Header="Detector" Binding="{ReflectionBinding Detector}" Width="*" /><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="100" /><TableViewColumn Header="Detected" Binding="{ReflectionBinding DetectedSinceReset}" Width="110" /><TableViewColumn Header="Retained" Binding="{ReflectionBinding Retained}" Width="100" /><TableViewColumn Header="Evicted" Binding="{ReflectionBinding CapacityEvictions}" Width="100" /></TableView.Columns></TableView></StackPanel></TabItem>
     <TabItem Header="Head alignment"><StackPanel Spacing="10" Margin="0,8,0,0"><WrapPanel><CheckBox Content="Enable alignment diagnostics" IsChecked="{Binding AlignmentEnabled, Mode=TwoWay}" /><NumericUpDown Value="{Binding BandLow, Mode=TwoWay}" Minimum="1" Maximum="90000" Width="110" Margin="8,0" AutomationProperties.Name="Alignment low band Hz" /><NumericUpDown Value="{Binding BandSplit, Mode=TwoWay}" Minimum="1" Maximum="90000" Width="110" AutomationProperties.Name="Alignment split band Hz" /><NumericUpDown Value="{Binding BandHigh, Mode=TwoWay}" Minimum="1" Maximum="96000" Width="110" Margin="8,0" AutomationProperties.Name="Alignment high band Hz" /><TextBox Text="{Binding KnownTone, Mode=TwoWay}" PlaceholderText="Known tone Hz (optional)" Width="190" AutomationProperties.Name="Known reference tone Hz" /><NumericUpDown Value="{Binding MaximumLag, Mode=TwoWay}" Minimum="1" Maximum="128" Width="90" Margin="8,0" AutomationProperties.Name="Maximum lag samples" /></WrapPanel><WrapPanel><Button Content="Zero here" Click="ZeroEdges" IsEnabled="{Binding CanZeroEdges}" Margin="0,0,8,0" /><Button Content="Clear zero" Click="ClearEdges" /><TextBlock Text="Damping s" Margin="8,0,4,0" VerticalAlignment="Center" /><NumericUpDown Value="{Binding EdgeDamping, Mode=TwoWay}" Minimum="0.1" Maximum="3" Increment="0.1" Width="95" AutomationProperties.Name="Edge display damping seconds" /><TextBlock Text="Dial ±%" Margin="8,0,4,0" VerticalAlignment="Center" /><NumericUpDown Value="{Binding EdgeRange, Mode=TwoWay}" Minimum="1" Maximum="1000" Width="95" AutomationProperties.Name="Relative edge dial range percent" /><CheckBox Content="Same tape section replayed" IsChecked="{Binding SameSection, Mode=TwoWay}" Margin="8,0" /><TextBox Text="{Binding CopyLabel, Mode=TwoWay}" PlaceholderText="Tape copy / section" Width="220" AutomationProperties.Name="Session-local tape copy label" /></WrapPanel><c:AudioChart Kind="HeadEdges" EdgeLeft="{Binding LeftEdge}" EdgeRight="{Binding RightEdge}" EdgeRange="{Binding EdgeRange}" Height="360" AutomationProperties.Name="Per-channel relative edges from manual zero, not mechanical angle" /><TextBlock Text="{Binding LeftEdge.Message}" TextWrapping="Wrap" Classes="muted" /><TextBlock Text="{Binding RightEdge.Message}" TextWrapping="Wrap" Classes="muted" /><TextBlock Text="{Binding AlignmentDetails}" TextWrapping="Wrap" Classes="muted" /><TableView ItemsSource="{Binding AlignmentChannels}" Height="180" AutomationProperties.Name="Alignment qualification and per-channel measurements"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="90" /><TableViewColumn Header="Assessable" Binding="{ReflectionBinding Assessable}" Width="100" /><TableViewColumn Header="Qualification" Binding="{ReflectionBinding Quality}" Width="2*" /><TableViewColumn Header="AC RMS" Binding="{ReflectionBinding AcRms}" Width="100" /><TableViewColumn Header="High band %" Binding="{ReflectionBinding HighBandPercent}" Width="110" /><TableViewColumn Header="Slope /ms" Binding="{ReflectionBinding NormalizedSlopePerMs}" Width="110" /><TableViewColumn Header="Rise µs" Binding="{ReflectionBinding RiseMicroseconds}" Width="100" /><TableViewColumn Header="Fall µs" Binding="{ReflectionBinding FallMicroseconds}" Width="100" /></TableView.Columns></TableView><c:AudioChart Kind="StereoIndicator" LiveSnapshot="{Binding Live}" Height="280" AutomationProperties.Name="Qualified stereo signal phase and delay, not mechanical angle" /><TableView ItemsSource="{Binding StereoRows}" Height="230" AutomationProperties.Name="Stereo evidence and qualification"><TableView.Columns><TableViewColumn Header="Metric" Binding="{ReflectionBinding Metric}" Width="200" /><TableViewColumn Header="Value" Binding="{ReflectionBinding Value}" Width="180" /><TableViewColumn Header="Meaning" Binding="{ReflectionBinding Meaning}" Width="*" /></TableView.Columns></TableView><WrapPanel><TextBox Text="{Binding Passage, Mode=TwoWay}" PlaceholderText="Same named reference passage" Width="320" AutomationProperties.Name="Alignment A/B reference passage" /><CheckBox Content="I confirm replay of this same passage" IsChecked="{Binding SamePassage, Mode=TwoWay}" Margin="8,0" /><Button Content="Save A" Click="SaveA" IsEnabled="{Binding CanSaveAlignment}" Margin="0,0,8,0" /><Button Content="Save B" Click="SaveB" IsEnabled="{Binding CanSaveAlignment}" /><Button Content="Clear A/B" Click="ClearComparison" Margin="8,0" /></WrapPanel><TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" /><c:AudioChart Kind="Alignment" Comparison="{Binding Comparison}" Height="360" AutomationProperties.Name="A and B relative graph with qualified original metric units" /><TableView ItemsSource="{Binding Differences}" Height="230" AutomationProperties.Name="Qualified A/B differences, no combined score"><TableView.Columns><TableViewColumn Header="Channel" Binding="{ReflectionBinding Channel}" Width="100" /><TableViewColumn Header="Metric" Binding="{ReflectionBinding Metric}" Width="*" /><TableViewColumn Header="Unit" Binding="{ReflectionBinding Unit}" Width="100" /><TableViewColumn Header="A" Binding="{ReflectionBinding A}" Width="140" /><TableViewColumn Header="B" Binding="{ReflectionBinding B}" Width="140" /><TableViewColumn Header="Δ B−A" Binding="{ReflectionBinding Delta}" Width="140" /></TableView.Columns></TableView></StackPanel></TabItem>
     <TabItem Header="Recordings"><Grid RowDefinitions="260,Auto,*" RowSpacing="10" Margin="0,8,0,0"><TableView x:Name="SavedRecordings" ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording, Mode=TwoWay}" AutomationProperties.Name="Finalized recording history"><TableView.Columns><TableViewColumn Header="Start UTC" Binding="{ReflectionBinding StartUtc}" Width="*" /><TableViewColumn Header="Integrity" Binding="{ReflectionBinding Integrity}" Width="130" /><TableViewColumn Header="End reason" Binding="{ReflectionBinding Reason}" Width="150" /><TableViewColumn Header="Saved frames" Binding="{ReflectionBinding Recording.SavedFrames}" Width="140" /><TableViewColumn Header="Manifest" Binding="{ReflectionBinding Recording.SidecarPath}" Width="2*" /></TableView.Columns></TableView><WrapPanel Grid.Row="1"><Button Content="Visual analysis" Click="OpenVisual" Margin="0,0,8,0" /><Button Content="Heuristic import" Click="OpenHeuristic" Margin="0,0,8,0" /><Button Content="Manual recovery" Click="OpenRecovery" Margin="0,0,8,0" /><Button Content="Reveal recording" Click="Reveal" /></WrapPanel><c:ReportViewer Grid.Row="2" Text="{Binding RecordingDetails}" /></Grid></TabItem>
    </TabControl>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource F2.surface}" BorderBrush="{DynamicResource F2.border}" BorderThickness="0,1,0,0" Padding="8"><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /><TextBlock Text="{Binding Statistics}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
 </Grid>
</Window>
