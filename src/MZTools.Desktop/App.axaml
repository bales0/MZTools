<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MZTools.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://MZTools.Desktop/Theme/Tokens.axaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MZTools.Desktop/Theme/SharedStyles.axaml" />
  </Application.Styles>
</Application>
