<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF is the visual reference. Keep the shared semantic keys for all existing views. -->
  <SolidColorBrush x:Key="F2.canvas">White</SolidColorBrush>
  <SolidColorBrush x:Key="F2.surface">White</SolidColorBrush>
  <SolidColorBrush x:Key="F2.subtle">#F0F0F0</SolidColorBrush>
  <SolidColorBrush x:Key="F2.border">LightGray</SolidColorBrush>
  <SolidColorBrush x:Key="F2.control-border">#ABADB3</SolidColorBrush>
  <SolidColorBrush x:Key="F2.text">Black</SolidColorBrush>
  <SolidColorBrush x:Key="F2.muted">#555555</SolidColorBrush>
  <SolidColorBrush x:Key="F2.accent">#0078D7</SolidColorBrush>
  <SolidColorBrush x:Key="F2.accent-soft">#E5F3FF</SolidColorBrush>
  <SolidColorBrush x:Key="F2.selected">#0078D7</SolidColorBrush>
  <SolidColorBrush x:Key="F2.focus">#0078D7</SolidColorBrush>
  <SolidColorBrush x:Key="F2.wave-l">SteelBlue</SolidColorBrush>
  <SolidColorBrush x:Key="F2.wave-r">DarkOrange</SolidColorBrush>
  <SolidColorBrush x:Key="F2.live-wave-l">RoyalBlue</SolidColorBrush>
  <SolidColorBrush x:Key="F2.live-wave-r">DarkOrange</SolidColorBrush>
  <SolidColorBrush x:Key="F2.pulse-sh">Blue</SolidColorBrush>
  <SolidColorBrush x:Key="F2.pulse-sl">Red</SolidColorBrush>
  <SolidColorBrush x:Key="F2.pulse-lh">Green</SolidColorBrush>
  <SolidColorBrush x:Key="F2.pulse-ll">DarkOrange</SolidColorBrush>
  <x:Double x:Key="F2.typography.body">12</x:Double>
  <x:Double x:Key="F2.typography.secondary">12</x:Double>
</ResourceDictionary>
