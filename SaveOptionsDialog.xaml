<Window x:Class="QDTool.SaveOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QDTool"
        Title="Save options"
        Icon="/images/MZTool.ico"
        SizeToContent="WidthAndHeight"
        MinWidth="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="headingTextBlock" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel x:Name="tapeOptionsPanel">
            <CheckBox x:Name="preserveTrailingCheckBox" Margin="0,0,0,8"/>
            <CheckBox x:Name="generateSidecarCheckBox"/>
            <TextBlock x:Name="existingSidecarTextBlock"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="22,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel x:Name="waveformOptionsPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default tape machine:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="machineComboBox" Grid.Column="1" SelectedIndex="0" MinWidth="130">
                    <ComboBoxItem Content="MZ-800"/>
                    <ComboBoxItem Content="MZ-700"/>
                </ComboBox>
            </Grid>

            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="0,7,0,0"
                       Text="Loader and speed are taken from each table row. This machine is used only for records without an explicit profile."/>

            <StackPanel x:Name="layoutOptionsPanel" Margin="0,14,0,0">
                <TextBlock Text="Output layout:" Margin="0,0,0,4"/>
                <RadioButton x:Name="unionRadioButton"
                             Content="Union — all records in one file"
                             IsChecked="True"/>
                <RadioButton x:Name="separateRadioButton"
                             Content="Separate — one file per record"
                             Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock x:Name="separateHintTextBlock"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="22,6,0,0"
                       Text="Separate files use the selected name as a base and add record number and name."/>
        </StackPanel>

        <local:CompressionOptionsControl x:Name="compressionOptionsControl"
                                         Visibility="Collapsed"/>

        <TextBlock x:Name="compressionScopeTextBlock"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Text="Compression settings apply to uncompressed input records. Recognized compressed records use the policy below."
                   Visibility="Collapsed"/>

        <GroupBox x:Name="existingCompressionGroupBox"
                  Header="Recognized compressed records"
                  Padding="10"
                  Margin="0,10,0,0"
                  Visibility="Collapsed">
            <StackPanel>
                <CheckBox x:Name="decompressKnownCheckBox"
                          Content="Decompress ZX0/ZX7 records for export"
                          Checked="DecompressKnownCheckBox_Changed"
                          Unchecked="DecompressKnownCheckBox_Changed"/>
                <TextBlock Foreground="DimGray"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"
                           Text="When disabled, recognized compressed records are copied unchanged. Decompression affects only the exported copy; embedded ZX7 description bytes and expert partial/skip data may not be recoverable."/>
            </StackPanel>
        </GroupBox>

        <Border x:Name="compressionPreviewBorder"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="compressionPreviewTextBlock" TextWrapping="Wrap"/>
                <TextBox x:Name="compressionDetailsTextBox"
                         Margin="0,9,0,0"
                         MaxHeight="190"
                         MinWidth="560"
                         Padding="4"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed"/>
                <ProgressBar x:Name="compressionPreviewProgressBar"
                             Height="5"
                             Margin="0,9,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="saveButton" Content="Save" Width="80" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
