<Window x:Class="QDTool.WavAnalysisStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/images/QDTool.ico"
        Title="Audio analysis statistics"
        Width="1100"
        Height="640"
        MinWidth="760"
        MinHeight="450"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="statisticsText"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="Transparent"
                 FontFamily="Consolas"
                 FontSize="13"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Padding="2"/>
        <Button Grid.Row="1"
                Content="OK"
                Width="82"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="Ok_Click"/>
    </Grid>
</Window>
