<UserControl x:Class="QDTool.DskEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowDrop="True" Drop="Control_Drop">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="dskAddButton" Content="Add..." Click="Add_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Export..." Click="Export_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button x:Name="dskRenameButton" Content="Rename..." Click="Rename_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button x:Name="dskDeleteButton" Content="Delete" Click="Delete_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Hex view" Click="Hex_Click" MinWidth="76" Margin="0,0,18,0"/>
            <Button Content="Save" Click="Save_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Save As..." Click="SaveAs_Click" MinWidth="76" Margin="0,0,18,0"/>
            <Button Content="Close DSK" Click="Close_Click" MinWidth="86"/>
            <CheckBox x:Name="dskShowSectorsCheckBox" Content="Show raw sectors" Margin="18,6,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed" Checked="ShowSectors_Changed" Unchecked="ShowSectors_Changed"/>
        </WrapPanel>
        <DataGrid x:Name="directoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"/>
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <TextBlock x:Name="infoText" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Grid.Row="3" x:Name="warningText" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
