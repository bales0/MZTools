<Window x:Class="QDTool.DskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MZTools DSK editor" Height="650" Width="1120" MinHeight="480" MinWidth="850"
        Icon="/images/MZTool.ico" AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Add..." Click="Add_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Export..." Click="Export_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Rename..." Click="Rename_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Delete" Click="Delete_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Hex view" Click="Hex_Click" MinWidth="76" Margin="0,0,18,0"/>
            <Button Content="Save" Click="Save_Click" MinWidth="76" Margin="0,0,6,0"/>
            <Button Content="Save As..." Click="SaveAs_Click" MinWidth="76"/>
        </WrapPanel>
        <DataGrid x:Name="directoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"/>
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <TextBlock x:Name="infoText" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Grid.Row="3" x:Name="warningText" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </Grid>
</Window>
