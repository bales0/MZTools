<UserControl x:Class="MZTools.DskEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MZTools"
        AllowDrop="True" Drop="Control_Drop">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
        <WrapPanel>
            <Button x:Name="diskMenuButton" Content="Disk &#x25BE;" Style="{StaticResource TopToolbarButton}" Click="DiskMenu_Click"
                    ToolTip="Disk operations: conversion, boot/system installation, read-only compare and filesystem structures">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="convertFormatMenu" Header="Convert Format..." IsEnabled="False"
                                  ToolTipService.ShowOnDisabled="True" Click="ConvertFormat_Click"/>
                        <MenuItem x:Name="installBootSystemMenu" Header="Install Boot/System..." IsEnabled="False"
                                  ToolTipService.ShowOnDisabled="True" Click="InstallBootSystem_Click"/>
                        <MenuItem x:Name="compareDiskMenu" Header="Compare with..." IsEnabled="False" Click="CompareDisk_Click"/>
                        <MenuItem x:Name="structureInspectorMenu" Header="Filesystem Structure Inspector..." IsEnabled="False" Click="StructureInspector_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Open..." Click="Open_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button x:Name="dskAddButton" Content="Add..." Click="Add_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button Content="Export..." Click="Export_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button Content="Hex view" Click="Hex_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button x:Name="dskPropertiesButton" Content="Properties..." Click="FileProperties_Click"
                    IsEnabled="False" ToolTipService.ShowOnDisabled="True" Style="{StaticResource TopToolbarButton}"/>
            <Button x:Name="dskDeleteButton" Content="Delete" Click="Delete_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button x:Name="dskSaveButton" Content="Save" Click="Save_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button x:Name="dskSaveAsButton" Content="Save As..." Click="SaveAs_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource TopToolbarButton}"/>
            <Grid x:Name="dskMoveButtons" Width="94" Margin="0,0,6,0" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button FontFamily="Segoe UI" Content="&#x2191;" Height="28" ToolTip="Move selected programs up" Click="MoveUp_Click"/>
                <Button Grid.Column="2" FontFamily="Segoe UI" Content="&#x2193;" Height="28" ToolTip="Move selected programs down" Click="MoveDown_Click"/>
            </Grid>
            <Border Style="{StaticResource TopToolbarSeparator}"/>
            <Button Content="New QD..." Click="NewQuickDisk_Click" Style="{StaticResource TopToolbarButton}"/>
            <Button Content="New DSK..." Click="NewDsk_Click" Style="{StaticResource TopToolbarButton}"/>
            <CheckBox x:Name="dskShowSectorsCheckBox" Content="Show raw sectors" Margin="18,6,0,0"
                      VerticalAlignment="Center" Visibility="Collapsed" Checked="ShowSectors_Changed" Unchecked="ShowSectors_Changed"/>
        </WrapPanel>
        </Border>
        <TabControl x:Name="dskViews" Grid.Row="1">
        <TabItem x:Name="filesTab" Header="Files"><Grid>
        <DataGrid x:Name="directoryGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                  BeginningEdit="DirectoryGrid_BeginningEdit" CellEditEnding="DirectoryGrid_CellEditEnding"
                  PreviewKeyDown="DirectoryGrid_PreviewKeyDown" SelectionChanged="Files_SelectionChanged"/>
        <DataGrid x:Name="multiIplGrid" AutoGenerateColumns="False" Visibility="Collapsed"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionChanged="MultiIplGrid_SelectionChanged" AllowDrop="True"
                  PreviewMouseLeftButtonDown="MultiIplGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="MultiIplGrid_PreviewMouseMove"
                  DragOver="MultiIplGrid_DragOver" DragLeave="MultiIplGrid_DragLeave" Drop="MultiIplGrid_Drop">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" IsReadOnly="True"/>
                <DataGridTextColumn Header="Menu name" Binding="{Binding MenuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="Original B" Binding="{Binding OriginalSize}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Packed B" Binding="{Binding PackedSize}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ratio" Binding="{Binding CompressionRatio}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="LOAD" Binding="{Binding LoadHex}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="EXEC" Binding="{Binding ExecHex}" Width="70" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Compression" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding CompressionChoices}"
                                      SelectedItem="{Binding Compression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanChangeCompression}" Padding="2,0"
                                      PreviewMouseLeftButtonDown="MultiIplCompression_PreviewMouseLeftButtonDown"
                                      SelectionChanged="MultiIplCompression_SelectionChanged"
                                      DropDownClosed="MultiIplCompression_DropDownClosed"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Start" Binding="{Binding StartBlock}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sectors" Binding="{Binding Sectors}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Applied" Binding="{Binding AppliedCompression}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        </Grid></TabItem>
        <TabItem x:Name="mapTab" Header="Disk Map">
            <Grid Margin="8" Background="Transparent" PreviewMouseLeftButtonDown="MapBackground_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="200"/><ColumnDefinition Width="6"/><ColumnDefinition Width="2*" MinWidth="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="100"/></Grid.RowDefinitions>
                <TextBlock x:Name="analysisSummaryText" Grid.ColumnSpan="3" TextWrapping="Wrap"
                           ToolTip="Automatic read-only analysis. Schematic descriptor order, not flux/timing. Metadata: orange; data: green; selected: blue."/>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                        <TextBlock Text="Order:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="mapOrderBox" SelectedIndex="0" SelectionChanged="MapOrder_Changed" Width="115" Margin="6,0,12,0">
                            <ComboBoxItem Content="Physical"/><ComboBoxItem x:Name="logicalMapOption" Content="Logical"/>
                        </ComboBox>
                        <TextBlock Text="Zoom:" VerticalAlignment="Center"/>
                        <Slider Minimum="0.6" Maximum="2" Value="1" Width="100" ValueChanged="MapZoom_Changed" Margin="6,0,12,0"/>
                        <Button x:Name="dskMapHexButton" Content="Hex view block" Click="SectorHex_Click" IsEnabled="False" Margin="4,0"/>
                        <Button x:Name="dskClearSelectionButton" Content="Clear selection" Click="ClearMapSelection_Click" IsEnabled="False"/>
                        <Button x:Name="structureInspectorButton" Content="Structure Inspector..." Click="StructureInspector_Click" IsEnabled="False" Margin="6,0"/>
                        <Button Content="Copy report" Click="CopyAnalysis_Click" Margin="6,0"/>
                        <Button Content="Save report..." Click="SaveAnalysis_Click"/>
                </WrapPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <local:DskDiskMapControl x:Name="diskMap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
                <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray"/>
                <Grid Grid.Row="2" Grid.Column="2" Margin="6,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
                    <UniformGrid Columns="5" Margin="0,0,0,4">
                        <Button x:Name="analysisAllButton" Content="All" Tag="0" Click="AnalysisCount_Click" FontSize="11"/>
                        <Button x:Name="analysisErrorsButton" Content="Errors" Tag="1" Click="AnalysisCount_Click" FontSize="11"/>
                        <Button x:Name="analysisUnsafeButton" Content="Unsafe" Tag="4" Click="AnalysisCount_Click" FontSize="11"/>
                        <Button x:Name="analysisWarningsButton" Content="Warn." Tag="2" Click="AnalysisCount_Click" FontSize="11"/>
                        <Button x:Name="analysisInfoButton" Content="Info" Tag="3" Click="AnalysisCount_Click" FontSize="11"/>
                    </UniformGrid>
                    <TabControl x:Name="mapInspectorTabs" Grid.Row="1">
                    <TabItem Header="Blocks">
                    <DataGrid x:Name="mapBlocksGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="MapBlocks_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Track" Binding="{Binding Track}" Width="55"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R}" Width="40"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="File / details" Binding="{Binding Files}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Bytes" Binding="{Binding DataLength}" Width="65"/>
                            <DataGridTextColumn Header="Offset" Binding="{Binding FileOffset, StringFormat=0x{0:X}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </TabItem>
                    <TabItem Header="Issues">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="4">
                                <TextBlock Text="Severity:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="analysisFilterBox" Width="100" SelectedIndex="0" SelectionChanged="AnalysisFilter_Changed">
                                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Errors"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="Info"/><ComboBoxItem Content="Unsafe"/>
                                </ComboBox>
                            </WrapPanel>
                            <ScrollViewer DockPanel.Dock="Top" Height="64" VerticalScrollBarVisibility="Auto" Margin="4,0,4,4">
                                <TextBlock x:Name="analysisSeverityText" TextWrapping="Wrap" FontSize="11"/>
                            </ScrollViewer>
                            <DataGrid x:Name="issuesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="Issue_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="180">
                                        <DataGridTextColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="ToolTip" Value="{Binding Explanation}"/></Style></DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    </TabControl>
                    <TextBox x:Name="sectorDetailText" Grid.Row="2" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock x:Name="infoText" TextWrapping="Wrap"/>
                <ProgressBar x:Name="multiIplProgressBar" Height="5" Margin="0,8,0,0"
                             IsIndeterminate="True" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="warningText" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
