<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);TestResults/**</DefaultItemExcludes>
    <AssemblyName>MZTools</AssemblyName>
    <AssemblyTitle>MZTools</AssemblyTitle>
    <Product>MZTools</Product>
    <ApplicationIcon>images\MZTool.ico</ApplicationIcon>
    <Version>0.9.9</Version>
    <FileVersion>0.9.9</FileVersion>
    <AssemblyVersion>0.9.9</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs;tests\**\*.cs" />
    <Page Remove="src\**\*.xaml;tests\**\*.xaml" />
    <Compile Remove="MZTool.Tests\**\*.cs" />
    <Compile Remove="MZTools.Capture\**\*.cs;MZTools.Capture.Tests\**\*.cs" />
    <Compile Remove="MZTools.Capture.Windows\**\*.cs;MZTools.Capture.Windows.Tests\**\*.cs" />
    <Compile Remove="MZTFileReader.cs;MZQFileReader.cs;QDFFileReader.cs" />
    <Resource Include="images\MZTool.ico" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\MZTools.Core\MZTools.Core.csproj" />
    <ProjectReference Include="MZTools.Capture\MZTools.Capture.csproj" />
    <ProjectReference Include="MZTools.Capture.Windows\MZTools.Capture.Windows.csproj" />
    <PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
    <PackageReference Include="org.sndfile.runtime.win-x64" Version="1.2.2" />
  </ItemGroup>

</Project>
