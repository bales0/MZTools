<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MZTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="QD\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="MZF\**\*.mzf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LEP\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ROM\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\specification\DSKA0001_Roland.QD" Condition="Exists('..\specification\DSKA0001_Roland.QD')" Link="QDReference\DSKA0001_Roland.QD" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\specification\DSKA0002_MO5_CQ90-028_formatted.QD" Condition="Exists('..\specification\DSKA0002_MO5_CQ90-028_formatted.QD')" Link="QDReference\DSKA0002_MO5_CQ90-028_formatted.QD" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\specification\DSKA0003_Akai_formatted.QD" Condition="Exists('..\specification\DSKA0003_Akai_formatted.QD')" Link="QDReference\DSKA0003_Akai_formatted.QD" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
