<Window x:Class="QDTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QDTool"
        mc:Ignorable="d"
        Title="MZTools" Height="600" Width="1100" MinHeight="480" MinWidth="900" Icon="/images/MZTool.ico"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop" Closing="MainWindow_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="112"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="MzfDataGrid" 
                  Grid.Row="0"
                  Grid.Column="0"
                  IsReadOnly="False"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="MzfDataGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="MzfDataGrid_PreviewMouseMove"
                  DragOver="MzfDataGrid_DragOver"
                  DragLeave="MzfDataGrid_DragLeave"
                  Drop="MzfDataGrid_Drop"
                  PreviewKeyDown="MzfDataGrid_PreviewKeyDown"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="MzfDataGrid_SelectionChanged" 
                  CanUserAddRows="False" 
                  VerticalGridLinesBrush="LightGray" 
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False" 
                  CanUserSortColumns="False" 
                  Margin="10,10,6,8">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding MzfFtypeName}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="File name" Binding="{Binding MzfFname}" Width="Auto" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding MzfSize}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size(Hex)" Binding="{Binding MzfSizeHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trailing" Binding="{Binding TrailingData}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Start" Binding="{Binding MzfStartHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Exec" Binding="{Binding MzfExecHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="Auto" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Description" Width="*" MinWidth="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MzfHeaderDescription}"
                                       Margin="4,2"
                                       ToolTip="{Binding MzfHeaderDescription}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Loader" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding LoaderType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="LoaderComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="88"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Speed" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                      SelectedItem="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="58"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="0" Grid.Column="1" Margin="6,10,10,8" Padding="8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <Button x:Name="openButton" Content="Open..." Click="button_Click_Open" Height="28"/>
                <Button x:Name="addButton" Content="Add..." Click="button_Click_Add" Height="28" Margin="0,6,0,0"/>
                <Button x:Name="saveButton" Content="Save As..." Click="button_Click_Save" Height="28" Margin="0,6,0,0"/>
                <Button x:Name="exportButton" Content="Export..." Click="button_Click_Export" Height="28" Margin="0,6,0,0"/>

                <Separator Margin="0,10,0,8"/>
                <Button x:Name="viewButton" Content="View" Click="button_Click_View" Height="28"/>
                <Button x:Name="deleteButton" Content="Delete" Click="button_Click_Delete" Height="28" Margin="0,6,0,0"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="moveUpButton" FontFamily="Segoe UI" Content="&#x2191;" Click="button_Click_Up" Height="28" ToolTip="Move selected rows up"/>
                    <Button x:Name="moveDownButton" Grid.Column="2" FontFamily="Segoe UI" Content="&#x2193;" Click="button_Click_Down" Height="28" ToolTip="Move selected rows down"/>
                </Grid>

                <Separator Margin="0,10,0,8"/>
                <Button x:Name="newQuickDiskButton" Content="New..." Click="button_Click_NewQuickDisk" Height="28"/>
                <Button x:Name="newDskButton" Content="New DSK..." Click="button_Click_NewDsk" Height="28" Margin="0,6,0,0"/>
                <Button x:Name="formatQuickDiskButton" Content="Format..." Click="button_Click_FormatQuickDisk" Height="28" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,10,10" Padding="9,6"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock x:Name="qdInfoText" Text="Quickdisk image type: —" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <Label x:Name="infoText" Content="No data loaded" Padding="0"/>
            </StackPanel>
        </Border>

        <local:DskEditorControl x:Name="dskEditorControl" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                Panel.ZIndex="10" Background="White" Visibility="Collapsed"/>
    </Grid>
</Window>
