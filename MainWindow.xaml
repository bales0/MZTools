<Window x:Class="MZTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MZTools"
        mc:Ignorable="d"
        Title="MZTools" Height="600" Width="1100" MinHeight="480" MinWidth="900" Icon="/MZTools;component/images/MZTool.ico"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop" Closing="MainWindow_Closing" PreviewMouseLeftButtonDown="MapBackground_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="10,10,10,0" Padding="8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
            <WrapPanel>
                <Button x:Name="openButton" Content="Open..." Click="button_Click_Open" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="addButton" Content="Add..." Click="button_Click_Add" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="exportButton" Content="Export..." Click="button_Click_Export" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="viewButton" Content="View" Click="button_Click_View" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="deleteButton" Content="Delete" Click="button_Click_Delete" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="saveButton" Content="Save" Click="button_Click_Save" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="saveAsButton" Content="Save As..." Click="button_Click_SaveAs" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="closeButton" Content="Close" Click="button_Click_Close" Style="{StaticResource TopToolbarButton}"/>
                <Grid Width="94" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="moveUpButton" FontFamily="Segoe UI" Content="&#x2191;" Click="button_Click_Up" Height="28" ToolTip="Move selected rows up"/>
                    <Button x:Name="moveDownButton" Grid.Column="2" FontFamily="Segoe UI" Content="&#x2193;" Click="button_Click_Down" Height="28" ToolTip="Move selected rows down"/>
                </Grid>
                <Border Style="{StaticResource TopToolbarSeparator}"/>
                <Button x:Name="newQuickDiskButton" Content="New QD..." Click="button_Click_NewQuickDisk" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="newDskButton" Content="New DSK..." Click="button_Click_NewDsk" Style="{StaticResource TopToolbarButton}"/>
                <Button x:Name="formatQuickDiskButton" Content="Format..." Click="button_Click_FormatQuickDisk" Style="{StaticResource TopToolbarButton}" Visibility="Collapsed"/>
            </WrapPanel>
        </Border>
        <TabControl x:Name="tapeViews" Grid.Row="1" Margin="10,8,10,8" SelectionChanged="TapeViews_SelectionChanged">
        <TabItem Header="Files">
        <Grid>
        <ContentControl x:Name="quickDiskInspectorHost" Visibility="Collapsed"/>
        <DataGrid x:Name="MzfDataGrid"
                  IsReadOnly="False"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="MzfDataGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="MzfDataGrid_PreviewMouseMove"
                  DragOver="MzfDataGrid_DragOver"
                  DragLeave="MzfDataGrid_DragLeave"
                  Drop="MzfDataGrid_Drop"
                  PreviewKeyDown="MzfDataGrid_PreviewKeyDown"
                  CellEditEnding="MzfDataGrid_CellEditEnding"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="MzfDataGrid_SelectionChanged" 
                  CanUserAddRows="False" 
                  VerticalGridLinesBrush="LightGray" 
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False" 
                  CanUserSortColumns="False" 
                  Margin="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding MzfFtypeName}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="fileNameColumn" Header="File name"
                                    Binding="{Binding MzfFname, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                    Width="Auto" MinWidth="140"/>
                <DataGridTextColumn Header="Size" Binding="{Binding MzfSize}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size(Hex)" Binding="{Binding MzfSizeHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trailing" Binding="{Binding TrailingData}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Start" Binding="{Binding MzfStartHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Exec" Binding="{Binding MzfExecHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="Auto" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Description" Width="*" MinWidth="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MzfHeaderDescription}"
                                       Margin="4,2"
                                       ToolTip="{Binding MzfHeaderDescription}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Loader" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding LoaderType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="LoaderComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="88"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Speed" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                      SelectedItem="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="58"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
        </TabItem>
        <TabItem x:Name="quickDiskMapTab" Header="Disk Map" Visibility="Collapsed">
            <Grid Margin="8" Background="Transparent" PreviewMouseLeftButtonDown="MapBackground_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="200"/><ColumnDefinition Width="6"/><ColumnDefinition Width="2*" MinWidth="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="quickDiskMapSummary" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <Button x:Name="quickDiskHexButton" Content="Hex view block" Click="QuickDiskHex_Click" IsEnabled="False" Margin="12,0,6,0"/>
                    <Button x:Name="quickDiskClearSelectionButton" Content="Clear selection" Click="ClearQuickDiskSelection_Click" IsEnabled="False"/>
                    <Button Content="Copy report" Click="QuickDiskCopyReport_Click" Margin="6,0"/>
                    <Button Content="Save report..." Click="QuickDiskSaveReport_Click"/>
                </WrapPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <local:QuickDiskMapControl x:Name="quickDiskMap"/>
                </ScrollViewer>
                <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray"/>
                <Grid Grid.Row="2" Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
                <DataGrid x:Name="quickDiskBlocks" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="QuickDiskBlocks_SelectionChanged" PreviewKeyDown="QuickDiskBlocks_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Role" Binding="{Binding Kind}" Width="Auto" MinWidth="100"/>
                        <DataGridTextColumn Header="#" Binding="{Binding FileNumber}" Width="32"/>
                        <DataGridTextColumn Header="File / details" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding Offset}" Width="Auto" MinWidth="100"/>
                        <DataGridTextColumn Header="Length*" Binding="{Binding Length}" Width="Auto" MinWidth="90"/>
                        <DataGridTextColumn Header="Payload B" Binding="{Binding Size}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="LOAD" Binding="{Binding LoadText}" Width="75"/>
                        <DataGridTextColumn Header="EXEC" Binding="{Binding ExecuteText}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox x:Name="quickDiskMapDetail" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="* Length is in the units shown above. Gaps are not necessarily free space."/>
                </Grid>
            </Grid>
        </TabItem>
        </TabControl>

        <Border x:Name="statusBorder" Grid.Row="2" Margin="10,0,10,10" Padding="9,6"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock x:Name="qdInfoText" Text="Quickdisk image type: —" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <Label x:Name="infoText" Content="No data loaded" Padding="0"/>
            </StackPanel>
        </Border>

        <local:DskEditorControl x:Name="dskEditorControl" Grid.RowSpan="3"
                                Panel.ZIndex="10" Background="White" Visibility="Collapsed"/>
    </Grid>
</Window>
